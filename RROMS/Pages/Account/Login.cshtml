@page
@model RROMS.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Staff Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staff Login - RROMS</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
            body {
                min-height: 100vh;
                background: linear-gradient(135deg, #edf4ff, #f8fafc);
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: Arial, sans-serif;
                padding: 24px;
            }

            .login-wrapper {
                width: 100%;
                max-width: 440px;
            }

            .brand {
                text-align: center;
                margin-bottom: 24px;
            }

            .brand-icon {
                width: 64px;
                height: 64px;
                margin: 0 auto 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #0d6efd;
                color: white;
                border-radius: 18px;
                font-size: 28px;
                font-weight: bold;
            }

            .brand h1 {
                font-size: 28px;
                font-weight: 700;
                margin-bottom: 6px;
                color: #172b4d;
            }

            .brand p {
                color: #6c757d;
                margin: 0;
            }

            .login-card {
                background: white;
                padding: 36px;
                border-radius: 18px;
                box-shadow: 0 12px 40px rgba(28, 55, 90, 0.10);
            }

            .login-card h2 {
                font-size: 23px;
                font-weight: 700;
                color: #172b4d;
            }

            .login-description {
                color: #6c757d;
                font-size: 14px;
                margin-bottom: 28px;
            }

            .form-label {
                font-weight: 600;
                font-size: 14px;
            }

            .form-control {
                min-height: 46px;
                border-radius: 9px;
            }

            .form-control:focus {
                box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.12);
            }

            .login-button {
                min-height: 48px;
                border-radius: 9px;
                font-weight: 600;
                margin-top: 12px;
            }

            .password-toggle {
                border-radius: 0 9px 9px 0;
            }

            .footer-text {
                text-align: center;
                color: #6c757d;
                font-size: 12px;
                margin-top: 22px;
            }

            @@media (max-width: 480px) {
                .login-card {
                    padding: 26px 22px;
                }
            }
    </style>
</head>

<body>
    <main class="login-wrapper">

        <div class="brand">
            <div class="brand-icon">R</div>
            <h1>RROMS</h1>
            <p>Restaurant Management System</p>
        </div>

        <section class="login-card">
            <h2>Staff Login</h2>
            <p class="login-description">
                Sign in to manage restaurant operations.
            </p>

            <form method="post" id="loginForm">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">
                        Email Address
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Enter your staff email"
                           autocomplete="username" />

                    <span asp-validation-for="Email"
                          class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">
                        Password
                    </label>

                    <div class="input-group">
                        <input asp-for="Password"
                               id="passwordInput"
                               class="form-control"
                               placeholder="Enter your password"
                               autocomplete="current-password" />

                        <button class="btn btn-outline-secondary password-toggle"
                                type="button"
                                id="togglePassword">
                            Show
                        </button>
                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger small"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="RememberMe"
                           class="form-check-input" />

                    <label asp-for="RememberMe"
                           class="form-check-label">
                        Remember me
                    </label>
                </div>

                <button type="submit"
                        class="btn btn-primary w-100 login-button">
                    Sign In
                </button>

            </form>
        </section>

        <div class="footer-text">
            &copy; @DateTime.Now.Year RROMS · Restaurant Staff Portal
        </div>

    </main>

    <script>
            const togglePassword =
                document.getElementById("togglePassword");

            const passwordInput =
                document.getElementById("passwordInput");

            togglePassword.addEventListener("click", function () {
                const isPassword =
                    passwordInput.type === "password";

                passwordInput.type =
                    isPassword ? "text" : "password";

                togglePassword.textContent =
                    isPassword ? "Hide" : "Show";
            });
    </script>

</body>
</html>