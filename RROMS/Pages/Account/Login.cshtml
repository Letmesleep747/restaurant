 @page
@model RROMS.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Staff Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staff Login - RROMS</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            padding: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f5f6f8;
            color: #252525;
            font-family: Arial, Helvetica, sans-serif;
        }

        .login-wrapper {
            width: 100%;
            max-width: 440px;
        }

        .brand {
            text-align: center;
            margin-bottom: 26px;
        }

        .brand-icon {
            width: 66px;
            height: 66px;
            margin: 0 auto 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #20252b;
            color: white;
            border-radius: 16px;
            font-size: 30px;
            font-weight: 700;
        }

        .brand h1 {
            font-size: 29px;
            font-weight: 700;
            margin-bottom: 6px;
            color: #20252b;
        }

        .brand p {
            color: #6c757d;
            font-size: 14px;
            margin: 0;
        }

        .login-card {
            background: #fff;
            padding: 36px;
            border: 1px solid #e9ecef;
            border-radius: 12px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
        }

        .login-card h2 {
            font-size: 23px;
            font-weight: 700;
            color: #252525;
            margin-bottom: 7px;
        }

        .login-description {
            color: #6c757d;
            font-size: 14px;
            margin-bottom: 27px;
        }

        .form-label {
            font-size: 14px;
            font-weight: 600;
            color: #343a40;
        }

        .form-control {
            min-height: 46px;
            border-radius: 7px;
            border: 1px solid #ced4da;
            font-size: 14px;
        }

        .form-control:focus {
            border-color: #6c8ebf;
            box-shadow: 0 0 0 3px rgba(32, 37, 43, 0.08);
        }

        .input-group .form-control {
            border-radius: 7px 0 0 7px;
        }

        .password-toggle {
            min-width: 68px;
            border-radius: 0 7px 7px 0;
        }

        .form-check-label {
            font-size: 14px;
            color: #555;
        }

        .login-button {
            min-height: 47px;
            margin-top: 12px;
            border-radius: 7px;
            font-size: 15px;
            font-weight: 600;
            background: #20252b;
            border-color: #20252b;
        }

        .login-button:hover {
            background: #343a40;
            border-color: #343a40;
        }

        .footer-text {
            text-align: center;
            color: #8a8f98;
            font-size: 12px;
            margin-top: 23px;
        }

        @@media (max-width: 480px) {
            body {
                padding: 18px;
            }

            .login-card {
                padding: 27px 22px;
            }
        }
    </style>
</head>

<body>

    <main class="login-wrapper">

        <div class="brand">
            <div class="brand-icon">
                <i class="bi bi-shop"></i>
            </div>

            <h1>RROMS</h1>
            <p>Restaurant Management System</p>
        </div>

        <section class="login-card">

            <h2>Staff Login</h2>

            <p class="login-description">
                Sign in to manage restaurant operations.
            </p>

            <form method="post" id="loginForm">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>

                <div class="mb-3">

                    <label asp-for="Email" class="form-label">
                        Email Address
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Enter your staff email"
                           autocomplete="username" />

                    <span asp-validation-for="Email"
                          class="text-danger small"></span>

                </div>

                <div class="mb-3">

                    <label asp-for="Password" class="form-label">
                        Password
                    </label>

                    <div class="input-group">

                        <input asp-for="Password"
                               id="passwordInput"
                               class="form-control"
                               placeholder="Enter your password"
                               autocomplete="current-password" />

                        <button class="btn btn-outline-secondary password-toggle"
                                type="button"
                                id="togglePassword">
                            Show
                        </button>

                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger small"></span>

                </div>

                <div class="form-check mb-3">

                    <input asp-for="RememberMe"
                           class="form-check-input" />

                    <label asp-for="RememberMe"
                           class="form-check-label">
                        Remember me
                    </label>

                </div>

                <button type="submit"
                        id="loginButton"
                        class="btn btn-dark w-100 login-button">

                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    <span id="loginButtonText">Sign In</span>

                </button>

            </form>

        </section>

        <div class="footer-text">
            &copy; @DateTime.Now.Year RROMS · Restaurant Staff Portal
        </div>

    </main>

    <script>
        
        const togglePassword =
            document.getElementById("togglePassword");

        const passwordInput =
            document.getElementById("passwordInput");

        // Password visibility
        togglePassword.addEventListener("click", function () {

            const isPassword = passwordInput.type === "password";

            passwordInput.type = isPassword ? "text" : "password";

            togglePassword.textContent = isPassword ? "Hide" : "Show";
        });

        // Login button animation
        const loginForm = document.getElementById("loginForm");
        const loginButton = document.getElementById("loginButton");
        const loginButtonText = document.getElementById("loginButtonText");

        let loginAnimation;

        loginForm.addEventListener("submit", function (event) {

            // Check form validation
            if (!loginForm.checkValidity()) {
                return;
            }

            // Prevent duplicate submissions
            if (loginButton.disabled) {
                event.preventDefault();
                return;
            }

            // Stop normal submission temporarily
            event.preventDefault();

            // Disable button
            loginButton.disabled = true;

            // Change button appearance
            loginButton.style.opacity = "0.75";
            loginButton.style.cursor = "not-allowed";

            // Start animation
            let dots = 0;

            loginButtonText.textContent = "Signing in";

            loginAnimation = setInterval(function () {

                dots = (dots + 1) % 4;

                loginButtonText.textContent =
                    "Signing in" + ".".repeat(dots);

            }, 300);

            // Allow browser to display the loading state,
            // then submit the form normally.
            setTimeout(function () {

                loginForm.submit();

            }, 150);

        });


    </script>

</body>
</html>