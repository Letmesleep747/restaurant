@page "{id:int}"
@model RROMS.Pages.Admin.Menu.Items.EditModel

@{
    ViewData["Title"] = "Edit Menu Item";
}

<div class="page-heading">
    <div>
        <a asp-page="./Index" class="text-decoration-none small mb-2 d-inline-block">
            <i class="bi bi-arrow-left"></i> Back to Menu Items
        </a>
        <h2>Edit Menu Item</h2>
        <p>Update the item details, category, price, image and availability.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-9">
        <div class="content-card restaurant-edit-card menu-item-edit-card">
            <div class="restaurant-form-heading">
                <div class="restaurant-form-icon">
                    <i class="bi bi-egg-fried"></i>
                </div>
                <div>
                    <h5>Menu Item Details</h5>
                    <p>Manage the information and ordering availability for this menu item</p>
                </div>
            </div>

            <form method="post" data-turbo="false" class="restaurant-edit-form menu-item-edit-form">
                <input type="hidden" asp-for="Item.Id" />
                <input type="hidden" asp-for="Item.CreatedAt" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label asp-for="Item.Name" class="form-label">Item Name</label>
                        <input asp-for="Item.Name" class="form-control" placeholder="e.g. Chicken Rice" />
                        <span asp-validation-for="Item.Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-4">
                        <label asp-for="Item.MenuCategoryId" class="form-label">Category</label>
                        <select asp-for="Item.MenuCategoryId" asp-items="Model.Categories" class="form-select">
                            <option value="">-- Select a category --</option>
                        </select>
                        <span asp-validation-for="Item.MenuCategoryId" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Item.Description" class="form-label">Description</label>
                    <textarea asp-for="Item.Description" class="form-control" rows="4"
                              placeholder="Describe the menu item"></textarea>
                    <span asp-validation-for="Item.Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label asp-for="Item.Price" class="form-label">Price (RM)</label>
                        <div class="input-group menu-item-price-group">
                            <span class="input-group-text">RM</span>
                            <input asp-for="Item.Price" type="number" min="0.01" max="999999.99"
                                   step="0.01" class="form-control" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Item.Price" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-4">
                        <label asp-for="Item.ImageUrl" class="form-label">Menu Item Image URL</label>
                        <input asp-for="Item.ImageUrl" id="imageUrlInput" type="url" class="form-control"
                               placeholder="https://example.com/menu-item.jpg" autocomplete="url" />
                        <div class="form-text">Paste a direct HTTP or HTTPS image URL. Leave empty if no image is needed.</div>
                        <span asp-validation-for="Item.ImageUrl" class="text-danger"></span>
                    </div>
                </div>

                <div class="menu-item-image-preview-box mb-4">
                    <div class="menu-item-preview-label">
                        <i class="bi bi-image"></i>
                        <span>Image Preview</span>
                    </div>
                    <img id="imagePreview"
                         src="@Model.Item.ImageUrl"
                         class="menu-image-preview @(string.IsNullOrWhiteSpace(Model.Item.ImageUrl) ? "d-none" : "")"
                         alt="Menu item image preview" />
                    <div id="imagePreviewEmpty" class="menu-item-preview-empty @(string.IsNullOrWhiteSpace(Model.Item.ImageUrl) ? "" : "d-none")">
                        <i class="bi bi-image"></i>
                        <span>Enter an image URL to preview the menu item photo</span>
                    </div>
                    <div id="imagePreviewError" class="small text-danger d-none mt-2">
                        The image could not be loaded. Check that the URL points directly to an image.
                    </div>
                </div>

                <div class="restaurant-status-box mb-4">
                    <div class="form-check form-switch mb-0">
                        <input asp-for="Item.IsAvailable" class="form-check-input" />
                        <label asp-for="Item.IsAvailable" class="form-check-label">Available for ordering</label>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 restaurant-form-actions">
                    <a asp-page="./Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const input = document.getElementById('imageUrlInput');
            const preview = document.getElementById('imagePreview');
            const error = document.getElementById('imagePreviewError');
            const empty = document.getElementById('imagePreviewEmpty');

            function updatePreview() {
                const url = input.value.trim();
                error.classList.add('d-none');

                if (!url) {
                    preview.removeAttribute('src');
                    preview.classList.add('d-none');
                    empty.classList.remove('d-none');
                    return;
                }

                try {
                    const parsed = new URL(url);
                    if (parsed.protocol !== 'https:' && parsed.protocol !== 'http:') {
                        preview.classList.add('d-none');
                        error.classList.remove('d-none');
                        return;
                    }

                    preview.onload = () => {
                        preview.classList.remove('d-none');
                        empty.classList.add('d-none');
                        error.classList.add('d-none');
                    };
                    preview.onerror = () => {
                        preview.classList.add('d-none');
                        empty.classList.add('d-none');
                        error.classList.remove('d-none');
                    };
                    preview.src = url;
                } catch {
                    preview.classList.add('d-none');
                    empty.classList.add('d-none');
                }
            }

            input.addEventListener('input', updatePreview);
            input.addEventListener('change', updatePreview);
            preview.onerror = () => {
                if (input.value.trim()) {
                    preview.classList.add('d-none');
                    empty.classList.add('d-none');
                    error.classList.remove('d-none');
                }
            };
        })();
    </script>
}
