@page
@model RROMS.Pages.Admin.Menu.Items.IndexModel

@{
    ViewData["Title"] = "Menu Items";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Menu Items</h2>
            <p class="text-muted mb-0">Manage menu images, descriptions, prices and availability.</p>
        </div>
        <a asp-page="./Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Add Menu Item</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Image</th>
                        <th>Item</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Price</th>
                        <th>Availability</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted">No menu items found. Add your first item.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" class="menu-item-thumbnail" />
                                    }
                                    else
                                    {
                                        <div class="menu-item-thumbnail-placeholder"><i class="bi bi-image"></i></div>
                                    }
                                </td>
                                <td class="fw-semibold">@item.Name</td>
                                <td>@(item.MenuCategory?.Name ?? "Unassigned")</td>
                                <td class="menu-item-description">@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</td>
                                <td class="text-nowrap">@item.Price.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-MY"))</td>
                                <td>
                                    @if (item.IsAvailable && item.MenuCategory?.IsActive == true)
                                    {
                                        <span class="badge bg-success">Available</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Unavailable</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <form method="post" asp-page-handler="ToggleAvailability" asp-route-id="@item.Id" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">@(item.IsAvailable ? "Mark Unavailable" : "Mark Available")</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
