
@page "{id:int}"
@model RROMS.Pages.Admin.Orders.DetailsModel

@{
    ViewData["Title"] = "Order Details";
}

<div class="container-fluid py-4">
    <a asp-page="./Index" class="text-decoration-none">
        <i class="bi bi-arrow-left"></i> Back to Orders
    </a>

    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body text-center py-5">
            <i class="bi bi-receipt display-4 text-muted"></i>
            <h3 class="mt-3">Order Details</h3>
            <p class="text-muted">Order reference: @Model.Id</p>
            <p class="text-muted">
                Order items and payment details will be loaded after database integration.
            </p>
        </div>
    </div>
</div>