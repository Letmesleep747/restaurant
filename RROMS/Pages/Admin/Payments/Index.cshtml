@page
@model RROMS.Pages.Admin.Payments.IndexModel

@{
    ViewData["Title"] = "Payment Monitoring";

    string StatusClass(string status) => status switch
    {
        "Paid" => "bg-success",
        "Pending" => "bg-warning text-dark",
        "Refunded" => "bg-info text-dark",
        "Failed" => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between
        align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Payment Monitoring</h2>
            <p class="text-muted mb-0">
                Review payment transactions and their related orders.
            </p>
        </div>

        <span class="badge bg-primary fs-6">
            @Model.TotalPayments Total Payments
        </span>
    </div>

    <!-- Summary cards -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Total Payments</div>
                    <div class="fs-3 fw-bold">@Model.TotalPayments</div>
                    <i class="bi bi-credit-card text-primary fs-4"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Paid Transactions</div>
                    <div class="fs-3 fw-bold">@Model.PaidPayments</div>
                    <i class="bi bi-check-circle text-success fs-4"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Pending Transactions</div>
                    <div class="fs-3 fw-bold">@Model.PendingPayments</div>
                    <i class="bi bi-clock-history text-warning fs-4"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Total Paid Amount</div>
                    <div class="fs-3 fw-bold">
                        RM @Model.TotalPaidAmount.ToString("N2")
                    </div>
                    <i class="bi bi-cash-stack text-success fs-4"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- Search and filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">

                <div class="col-12 col-md-4">
                    <label asp-for="SearchTerm" class="form-label">
                        Search
                    </label>
                    <input asp-for="SearchTerm"
                           class="form-control"
                           placeholder="Payment ID, customer or reference" />
                </div>

                <div class="col-12 col-md-3">
                    <label asp-for="PaymentDate" class="form-label">
                        Transaction Date
                    </label>
                    <input asp-for="PaymentDate"
                           type="date"
                           class="form-control" />
                </div>

                <div class="col-12 col-md-3">
                    <label asp-for="StatusFilter" class="form-label">
                        Payment Status
                    </label>
                    <select asp-for="StatusFilter" class="form-select">
                        <option value="">All statuses</option>
                        <option value="Paid">Paid</option>
                        <option value="Pending">Pending</option>
                        <option value="Refunded">Refunded</option>
                        <option value="Failed">Failed</option>
                    </select>
                </div>

                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary flex-fill">
                        <i class="bi bi-search me-1"></i>
                        Search
                    </button>

                    <a asp-page="./Index"
                       class="btn btn-outline-secondary"
                       title="Clear filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>

            </form>
        </div>
    </div>

    <!-- Payment records -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3
            d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Payment Records</h5>
            <span class="text-muted small">
                @Model.PaymentRecords.Count record(s) found
            </span>
        </div>

        <div class="card-body p-0">

            @if (Model.PaymentRecords.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Payment</th>
                                <th>Order</th>
                                <th>Customer</th>
                                <th>Method</th>
                                <th>Transaction Date</th>
                                <th>Reference</th>
                                <th>Status</th>
                                <th class="text-end pe-3">Amount</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var payment in Model.PaymentRecords)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">
                                        #@payment.Id
                                    </td>

                                    <td>
                                        <a asp-page="/Admin/Orders/Details"
                                           asp-route-id="@payment.OrderId"
                                           class="text-decoration-none">
                                            #@payment.OrderId
                                        </a>
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @(payment.Order?.Customer?.FullName
                                                ?? "Unknown customer")
                                        </div>
                                        <div class="text-muted small">
                                            @(payment.Order?.Customer?.Email
                                                ?? payment.Order?.CustomerId
                                                ?? "Customer unavailable")
                                        </div>
                                    </td>

                                    <td>@payment.Method</td>

                                    <td>
                                        @(payment.TransactionDate?.ToString("dd MMM yyyy")
                                            ?? "Not recorded")
                                        <div class="text-muted small">
                                            @(payment.TransactionDate?.ToString("hh:mm tt")
                                                ?? string.Empty)
                                        </div>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(
                                            payment.TransactionReference))
                                        {
                                            <span class="text-break">
                                                @payment.TransactionReference
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                    <td>
                                        <span class="badge @StatusClass(payment.Status)">
                                            @payment.Status
                                        </span>
                                    </td>

                                    <td class="text-end pe-3 fw-semibold">
                                        RM @payment.Amount.ToString("N2")
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 px-3">
                    <i class="bi bi-credit-card display-4 text-muted"></i>
                    <h5 class="mt-3">No payments found</h5>
                    <p class="text-muted mb-0">
                        Try changing your search criteria or clearing the filters.
                    </p>
                </div>
            }

        </div>
    </div>

</div>