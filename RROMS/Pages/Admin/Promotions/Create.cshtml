@page
@model RROMS.Pages.Admin.Promotions.CreateModel

@{
    ViewData["Title"] = "Create Promotion";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <a asp-page="./Index" class="text-decoration-none">
            <i class="bi bi-arrow-left"></i> Back to Promotions
        </a>
        <h2 class="fw-bold mt-3">Create Promotion</h2>
        <p class="text-muted">
            Add a new discount offer for your restaurant.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form method="post" data-turbo="false">
                @if (!ViewData.ModelState.IsValid
                    && ViewData.ModelState.Values
                        .SelectMany(v => v.Errors)
                        .Any())
                {
                    <div asp-validation-summary="All"
                         class="alert alert-danger"
                         role="alert"></div>
                }

                <div class="mb-3">
                    <label asp-for="Promotion.Name"
                           class="form-label">Promotion Name</label>
                    <input asp-for="Promotion.Name"
                           class="form-control"
                           placeholder="e.g. Weekend Special" />
                    <span asp-validation-for="Promotion.Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Promotion.Description"
                           class="form-label">Description</label>
                    <textarea asp-for="Promotion.Description"
                              class="form-control"
                              rows="3"
                              placeholder="Describe this promotion"></textarea>
                    <span asp-validation-for="Promotion.Description"
                          class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Promotion.DiscountType"
                               class="form-label">Discount Type</label>
                        <select asp-for="Promotion.DiscountType"
                                class="form-select">
                            <option value="Percentage">Percentage (%)</option>
                            <option value="FixedAmount">Fixed Amount (RM)</option>
                        </select>
                        <span asp-validation-for="Promotion.DiscountType"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Promotion.DiscountValue"
                               class="form-label">Discount Value</label>
                        <input asp-for="Promotion.DiscountValue"
                               type="number"
                               min="0.01"
                               max="100000"
                               step="0.01"
                               class="form-control"
                               placeholder="Enter discount value" />
                        <div class="form-text">
                            Percentage discounts cannot exceed 100%.
                        </div>
                        <span asp-validation-for="Promotion.DiscountValue"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Promotion.StartDate"
                               class="form-label">Start Date</label>
                        <input asp-for="Promotion.StartDate"
                               type="date"
                               asp-format="{0:yyyy-MM-dd}"
                               class="form-control" />
                        <span asp-validation-for="Promotion.StartDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Promotion.EndDate"
                               class="form-label">End Date</label>
                        <input asp-for="Promotion.EndDate"
                               type="date"
                               asp-format="{0:yyyy-MM-dd}"
                               class="form-control" />
                        <span asp-validation-for="Promotion.EndDate"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="form-check form-switch mb-4">
                    <input asp-for="Promotion.IsActive"
                           class="form-check-input" />
                    <label asp-for="Promotion.IsActive"
                           class="form-check-label">
                        Activate promotion immediately
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>
                        Create Promotion
                    </button>
                    <a asp-page="./Index"
                       class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}