@page
@model RROMS.Pages.Admin.Promotions.IndexModel

@{
    ViewData["Title"] = "Promotions";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Promotions & Discounts</h2>
            <p class="text-muted mb-0">
                Manage restaurant promotions and discount offers.
            </p>
        </div>

        <a asp-page="./Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Create Promotion
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            @if (Model.Promotions.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-tag fs-1 text-muted"></i>
                    <h5 class="mt-3">No promotions found</h5>
                    <p class="text-muted">
                        Create your first promotion to get started.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Promotion</th>
                                <th>Discount</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var promotion in Model.Promotions)
                            {
                                var isWithinDates =
                                    promotion.StartDate.Date <= DateTime.Today &&
                                    promotion.EndDate.Date >= DateTime.Today;

                                <tr>
                                    <td>
                                        <div class="fw-semibold">
                                            @promotion.Name
                                        </div>
                                        <small class="text-muted">
                                            @(string.IsNullOrWhiteSpace(promotion.Description)
                                                ? "No description"
                                                : promotion.Description)
                                        </small>
                                    </td>

                                    <td>
                                        @if (promotion.DiscountType == "Percentage")
                                        {
                                            @($"{promotion.DiscountValue:0.##}%")
                                        }
                                        else
                                        {
                                            @($"RM {promotion.DiscountValue:0.00}")
                                        }
                                        <div>
                                            <small class="text-muted">
                                                @promotion.DiscountType
                                            </small>
                                        </div>
                                    </td>

                                    <td>
                                        @promotion.StartDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @promotion.EndDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @if (!promotion.IsActive)
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }
                                        else if (!isWithinDates)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Outside Date Range
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <a asp-page="./Edit"
                                           asp-route-id="@promotion.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                            Edit
                                        </a>

                                        <form method="post"
                                              asp-page-handler="ToggleStatus"
                                              asp-route-id="@promotion.Id"
                                              class="d-inline">
                                            <button type="submit"
                                                    class="btn btn-sm @(promotion.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                                @(promotion.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>