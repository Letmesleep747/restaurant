
@page
@model RROMS.Pages.Admin.Reports.IndexModel

@{
    ViewData["Title"] = "Reports & Analytics";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Reports & Analytics</h2>
        <p class="text-muted mb-0">
            Review restaurant performance and operational statistics.
        </p>
    </div>

    @if (Model.ValidationMessage != null)
    {
        <div class="alert alert-warning">
            @Model.ValidationMessage
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h5 class="mb-3">Report Period</h5>

            <form method="get" class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label asp-for="StartDate" class="form-label">
                        Start Date
                    </label>
                    <input asp-for="StartDate"
                           type="date"
                           asp-format="{0:yyyy-MM-dd}"
                           class="form-control" />
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="EndDate" class="form-label">
                        End Date
                    </label>
                    <input asp-for="EndDate"
                           type="date"
                           asp-format="{0:yyyy-MM-dd}"
                           class="form-control" />
                </div>

                <div class="col-12 col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel me-1"></i>
                        Apply Filters
                    </button>

                    <a asp-page="./Index"
                       class="btn btn-outline-secondary">
                        Reset
                    </a>
                </div>
            </form>

            <small class="text-muted d-block mt-2">
                Leave both dates blank to view all available records.
            </small>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Total Reservations</div>
                    <div class="fs-3 fw-bold">
                        @Model.TotalReservations
                    </div>
                    <i class="bi bi-calendar-check text-primary fs-4"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Total Orders</div>
                    <div class="fs-3 fw-bold">@Model.TotalOrders</div>
                    <i class="bi bi-receipt text-info fs-4"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Completed Orders</div>
                    <div class="fs-3 fw-bold">@Model.CompletedOrders</div>
                    <i class="bi bi-check-circle text-success fs-4"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Paid Revenue</div>
                    <div class="fs-3 fw-bold">
                        RM @Model.TotalRevenue.ToString("N2")
                    </div>
                    <i class="bi bi-currency-dollar text-warning fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-xl-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Reservation Overview</h5>
                </div>

                <div class="card-body">
                    <div class="d-flex justify-content-between py-3 border-bottom">
                        <span>Pending</span>
                        <span class="badge bg-warning text-dark">
                            @Model.PendingReservations
                        </span>
                    </div>

                    <div class="d-flex justify-content-between py-3 border-bottom">
                        <span>Confirmed</span>
                        <span class="badge bg-success">
                            @Model.ConfirmedReservations
                        </span>
                    </div>

                    <div class="d-flex justify-content-between py-3">
                        <span>Cancelled</span>
                        <span class="badge bg-secondary">
                            @Model.CancelledReservations
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Top 5 Popular Menu Items</h5>
                </div>

                <div class="card-body">
                    @if (Model.PopularItems.Count == 0)
                    {
                        <p class="text-muted text-center py-4 mb-0">
                            No order-item records were found for this period.
                        </p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Menu Item</th>
                                        <th class="text-end">Quantity Ordered</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.PopularItems)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">
                                                    @item.Name
                                                </div>
                                                <small class="text-muted">
                                                    Item ID: @item.MenuItemId
                                                </small>
                                            </td>
                                            <td class="text-end fw-semibold">
                                                @item.QuantityOrdered
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info mt-4 mb-0">
        <i class="bi bi-info-circle me-2"></i>
        Revenue is calculated from payments marked as Paid with a transaction
        date in the selected period. Cancelled orders are excluded from popular
        menu-item rankings.
    </div>

</div>
