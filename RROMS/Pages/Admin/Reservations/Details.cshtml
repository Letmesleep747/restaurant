@page "{id:int}"
@model RROMS.Pages.Admin.Reservations.DetailsModel

@{
    ViewData["Title"] = "Reservation Details";

    var reservation = Model.Reservation!;

    string StatusClass(string status) => status switch
    {
        "Pending" => "bg-warning text-dark",
        "Confirmed" => "bg-success",
        "Cancelled" => "bg-danger",
        "NoShow" => "bg-secondary",
        _ => "bg-light text-dark"
    };

    string StatusLabel(string status) => status switch
    {
        "NoShow" => "No Show",
        _ => status
    };

    var startDateTime =
        reservation.ReservationDate.Date.Add(reservation.StartTime);

    var endDateTime =
        startDateTime.AddMinutes(reservation.DurationMinutes);
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <a asp-page="./Index" class="text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Reservations
        </a>

        <div class="d-flex flex-wrap justify-content-between
            align-items-center gap-3 mt-3">
            <div>
                <h2 class="fw-bold mb-1">Reservation Details</h2>
                <p class="text-muted mb-0">
                    Reservation reference #@reservation.Id
                </p>
            </div>

            <span class="badge @StatusClass(reservation.Status) fs-6">
                @StatusLabel(reservation.Status)
            </span>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-calendar-check me-2"></i>
                        Booking Information
                    </h5>
                </div>

                <div class="card-body">
                    <dl class="row mb-0">

                        <dt class="col-sm-5 text-muted">
                            Reservation ID
                        </dt>
                        <dd class="col-sm-7">#@reservation.Id</dd>

                        <dt class="col-sm-5 text-muted">
                            Reservation Date
                        </dt>
                        <dd class="col-sm-7">
                            @reservation.ReservationDate.ToString("dd MMMM yyyy")
                        </dd>

                        <dt class="col-sm-5 text-muted">
                            Start Time
                        </dt>
                        <dd class="col-sm-7">
                            @startDateTime.ToString("hh:mm tt")
                        </dd>

                        <dt class="col-sm-5 text-muted">
                            End Time
                        </dt>
                        <dd class="col-sm-7">
                            @endDateTime.ToString("hh:mm tt")
                        </dd>

                        <dt class="col-sm-5 text-muted">
                            Duration
                        </dt>
                        <dd class="col-sm-7">
                            @reservation.DurationMinutes minutes
                        </dd>

                        <dt class="col-sm-5 text-muted">
                            Party Size
                        </dt>
                        <dd class="col-sm-7">
                            @reservation.PartySize guest(s)
                        </dd>

                        <dt class="col-sm-5 text-muted">
                            Table
                        </dt>
                        <dd class="col-sm-7">
                            @if (reservation.Table != null)
                            {
                                <div>
                                    @reservation.Table.TableNumber
                                </div>
                                <div class="text-muted small">
                                    @(reservation.Table.DiningArea?.Name
                                        ?? "Dining area unavailable")
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">Not assigned</span>
                            }
                        </dd>

                        <dt class="col-sm-5 text-muted">
                            Special Requests
                        </dt>
                        <dd class="col-sm-7">
                            @(string.IsNullOrWhiteSpace(reservation.SpecialRequests)
                                ? "None"
                                : reservation.SpecialRequests)
                        </dd>

                    </dl>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-person me-2"></i>
                        Customer Information
                    </h5>
                </div>

                <div class="card-body">
                    <dl class="row mb-0">

                        <dt class="col-sm-4 text-muted">Name</dt>
                        <dd class="col-sm-8">
                            @(reservation.Customer?.FullName
                                ?? "Unknown customer")
                        </dd>

                        <dt class="col-sm-4 text-muted">Email</dt>
                        <dd class="col-sm-8">
                            @(reservation.Customer?.Email ?? "Not provided")
                        </dd>

                        <dt class="col-sm-4 text-muted">Phone</dt>
                        <dd class="col-sm-8">
                            @(reservation.Customer?.PhoneNumber ?? "Not provided")
                        </dd>

                    </dl>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-clock-history me-2"></i>
                        Record Information
                    </h5>
                </div>

                <div class="card-body">
                    <dl class="row mb-0">

                        <dt class="col-sm-5 text-muted">Created At</dt>
                        <dd class="col-sm-7">
                            @reservation.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                        </dd>

                        <dt class="col-sm-5 text-muted">Updated At</dt>
                        <dd class="col-sm-7">
                            @(reservation.UpdatedAt?.ToString("dd MMM yyyy, hh:mm tt")
                                ?? "Not updated")
                        </dd>

                    </dl>
                </div>
            </div>
        </div>

    </div>

</div>