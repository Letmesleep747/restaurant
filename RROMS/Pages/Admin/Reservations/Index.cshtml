
@page
@model RROMS.Pages.Admin.Reservations.IndexModel

@{
    ViewData["Title"] = "Reservation Monitoring";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Reservation Monitoring</h2>
        <p class="text-muted mb-0">
            Monitor customer reservations and booking activity.
        </p>
    </div>

    <div class="alert alert-info d-flex align-items-start gap-2">
        <i class="bi bi-info-circle fs-5"></i>
        <div>
            <strong>Database integration pending</strong>
            <div>
                This page is ready for integration. Reservation records
                will appear after the customer-side models and database
                tables are connected.
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Total Reservations</div>
                    <div class="fs-3 fw-bold">
                        @Model.TotalReservations
                    </div>
                    <i class="bi bi-calendar-check text-primary fs-4"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Pending</div>
                    <div class="fs-3 fw-bold">
                        @Model.PendingReservations
                    </div>
                    <i class="bi bi-clock-history text-warning fs-4"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Confirmed</div>
                    <div class="fs-3 fw-bold">
                        @Model.ConfirmedReservations
                    </div>
                    <i class="bi bi-check-circle text-success fs-4"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Cancelled</div>
                    <div class="fs-3 fw-bold">
                        @Model.CancelledReservations
                    </div>
                    <i class="bi bi-x-circle text-danger fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">

                <div class="col-12 col-md-4">
                    <label asp-for="SearchTerm" class="form-label">
                        Search
                    </label>
                    <input asp-for="SearchTerm"
                           class="form-control"
                           placeholder="Customer name or reservation ID" />
                </div>

                <div class="col-12 col-md-3">
                    <label asp-for="ReservationDate" class="form-label">
                        Reservation Date
                    </label>
                    <input asp-for="ReservationDate"
                           type="date"
                           class="form-control" />
                </div>

                <div class="col-12 col-md-3">
                    <label asp-for="StatusFilter" class="form-label">
                        Status
                    </label>
                    <select asp-for="StatusFilter" class="form-select">
                        <option value="">All statuses</option>
                        <option value="Pending">Pending</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="Cancelled">Cancelled</option>
                        <option value="NoShow">No Show</option>
                    </select>
                </div>

                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="bi bi-search me-1"></i> Search
                    </button>
                    <a asp-page="./Index"
                       class="btn btn-outline-secondary"
                       title="Clear filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>

            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Reservation Records</h5>
        </div>

        <div class="card-body">
            <div class="text-center py-5">
                <i class="bi bi-calendar2-week display-4 text-muted"></i>
                <h5 class="mt-3">No reservation records to display</h5>
                <p class="text-muted mb-0">
                    Reservation data will be displayed here after integration.
                </p>
            </div>
        </div>
    </div>

</div>