@page
@model RROMS.Pages.Admin.Restaurant.CreateDiningAreaModel

@{
    ViewData["Title"] = "Add Dining Area";
}

<div class="page-heading">

    <div>
        <h2>Add Dining Area</h2>

        <p>
            Create a new dining section for the restaurant.
        </p>
    </div>

</div>


<div class="row">

    <div class="col-lg-7 col-xl-6">

        <div class="content-card">

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="mb-3">

                    <label asp-for="Input.Name"
                           class="form-label">
                    </label>

                    <input asp-for="Input.Name"
                           class="form-control"
                           placeholder="e.g. Indoor Dining" />

                    <span asp-validation-for="Input.Name"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="Input.Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Input.Description"
                              class="form-control"
                              rows="4"
                              placeholder="Enter a short description">
                    </textarea>

                    <span asp-validation-for="Input.Description"
                          class="text-danger">
                    </span>

                </div>


                <div class="form-check form-switch mb-4">

                    <input asp-for="Input.IsActive"
                           class="form-check-input" />

                    <label asp-for="Input.IsActive"
                           class="form-check-label">
                        Dining area is active
                    </label>

                </div>


                <div class="d-flex justify-content-end gap-2">

                    <a asp-page="DiningAreas"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg"></i>
                        Save Dining Area

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}