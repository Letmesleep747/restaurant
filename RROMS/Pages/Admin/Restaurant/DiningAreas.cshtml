@page
@model RROMS.Pages.Admin.Restaurant.DiningAreasModel

@{
    ViewData["Title"] = "Dining Areas";
    Layout = "_AdminLayout";
}

<div class="page-heading">

    <div>
        <h2>Dining Area Management</h2>

        <p>
            Manage the different dining sections available in the restaurant.
        </p>
    </div>

    <button class="btn btn-primary"
            type="button"
            disabled>

        <i class="bi bi-plus-lg"></i>
        Add Dining Area

    </button>

</div>


<div class="content-card">

    <div class="content-card-header">

        <div>
            <h5>Dining Areas</h5>

            <small class="text-muted">
                Current restaurant dining sections
            </small>
        </div>

        <span class="badge text-bg-light">
            @Model.DiningAreas.Count Areas
        </span>

    </div>


    <div class="table-responsive">

        <table class="table admin-table">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Dining Area</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var area in Model.DiningAreas)
                {
                    <tr>

                        <td>@area.Id</td>

                        <td>
                            <strong>@area.Name</strong>
                        </td>

                        <td>@area.Description</td>

                        <td>
                            @if (area.IsActive)
                            {
                                <span class="status-badge active">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="status-badge inactive">
                                    Inactive
                                </span>
                            }
                        </td>

                        <td>

                            <button class="btn btn-sm btn-outline-secondary"
                                    disabled>
                                Edit
                            </button>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


<div class="alert alert-light border mt-4">

    <i class="bi bi-info-circle me-2"></i>

    Dining Area CRUD functionality will be connected to SQL Server
    during the next development phase.

</div>