@page "{id:int}"
@model RROMS.Pages.Admin.Restaurant.EditDiningAreaModel

@{
    ViewData["Title"] = "Edit Dining Area";
}

<div class="page-heading">

    <div>
        <h2>Edit Dining Area</h2>

        <p>
            Update dining area information and availability.
        </p>
    </div>

</div>


<div class="row justify-content-center">

    <div class="col-lg-9 col-xl-8">

        <div class="content-card dining-area-edit-card">

            <div class="dining-area-form-heading">
                <div class="dining-area-form-icon">
                    <i class="bi bi-building-gear"></i>
                </div>
                <div>
                    <h5>Dining Area Details</h5>
                    <p>Make changes to the dining area information below.</p>
                </div>
            </div>

            <form method="post" class="dining-area-edit-form">

                <input asp-for="Id"
                       type="hidden" />


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="mb-4">

                    <label asp-for="Input.Name"
                           class="form-label">
                    </label>

                    <input asp-for="Input.Name"
                           class="form-control" />

                    <span asp-validation-for="Input.Name"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-4">

                    <label asp-for="Input.Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Input.Description"
                              class="form-control"
                              rows="4">
                    </textarea>

                    <span asp-validation-for="Input.Description"
                          class="text-danger">
                    </span>

                </div>


                <div class="dining-area-status-box mb-4">

                <div class="form-check form-switch mb-0">

                    <input asp-for="Input.IsActive"
                           class="form-check-input" />

                    <label asp-for="Input.IsActive"
                           class="form-check-label">
                        Dining area is active
                    </label>

                </div>

                </div>

                <div class="d-flex justify-content-end gap-2 dining-area-form-actions">

                    <a asp-page="DiningAreas"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg"></i>
                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}