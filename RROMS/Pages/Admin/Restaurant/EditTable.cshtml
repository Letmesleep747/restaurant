@page "{id:int}"
@model RROMS.Pages.Admin.Restaurant.EditTableModel

@{
    ViewData["Title"] = "Edit Table";
    Layout = "_AdminLayout";
}


<div class="page-heading">

    <div>

        <h2>Edit Restaurant Table</h2>

        <p>
            Update table information,
            seating capacity and status.
        </p>

    </div>

</div>


<div class="row">

    <div class="col-lg-7 col-xl-6">

        <div class="content-card">

            <form method="post">

                <input asp-for="Id"
                       type="hidden" />


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>



                <!-- Dining Area -->
                <div class="mb-3">

                    <label asp-for="Input.DiningAreaId"
                           class="form-label">
                    </label>


                    <select asp-for="Input.DiningAreaId"
                            class="form-select">

                        @foreach (var area in Model.DiningAreas)
                        {
                            if (area.IsActive)
                            {
                                <option value="@area.DiningAreaId">
                                    @area.Name
                                </option>
                            }

                            else
                            {
                                <option value="@area.DiningAreaId">
                                    @area.Name (Inactive)
                                </option>
                            }
                        }

                    </select>


                    <span asp-validation-for="Input.DiningAreaId"
                          class="text-danger">
                    </span>

                </div>



                <!-- Table Number -->
                <div class="mb-3">

                    <label asp-for="Input.TableNumber"
                           class="form-label">
                    </label>


                    <input asp-for="Input.TableNumber"
                           class="form-control" />


                    <span asp-validation-for="Input.TableNumber"
                          class="text-danger">
                    </span>

                </div>



                <!-- Capacity -->
                <div class="mb-3">

                    <label asp-for="Input.Capacity"
                           class="form-label">
                    </label>


                    <input asp-for="Input.Capacity"
                           type="number"
                           min="1"
                           class="form-control" />


                    <span asp-validation-for="Input.Capacity"
                          class="text-danger">
                    </span>

                </div>



                <!-- Active -->
                <div class="form-check form-switch mb-4">

                    <input asp-for="Input.IsActive"
                           class="form-check-input" />


                    <label asp-for="Input.IsActive"
                           class="form-check-label">

                        Restaurant table is active

                    </label>

                </div>



                <div class="d-flex justify-content-end gap-2">

                    <a asp-page="/Admin/Restaurant/Tables"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>


                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg"></i>
                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}