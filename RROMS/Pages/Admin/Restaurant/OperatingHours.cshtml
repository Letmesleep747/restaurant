@page
@model RROMS.Pages.Admin.Restaurant.OperatingHoursModel

@{
    ViewData["Title"] = "Operating Hours";
    Layout = "_AdminLayout";
}


<div class="page-heading">

    <div>
        <h2>Operating Hours</h2>

        <p>
            Configure the restaurant's weekly opening
            and closing schedule.
        </p>
    </div>

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        <i class="bi bi-check-circle me-2"></i>

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">

        <i class="bi bi-exclamation-circle me-2"></i>

        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<div class="content-card">

    <div class="content-card-header">

        <div>

            <h5>
                Weekly Operating Schedule
            </h5>

            <small class="text-muted">
                Configure restaurant availability
                for each day of the week.
            </small>

        </div>

    </div>


    <form method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <div class="table-responsive">

            <table class="table admin-table">

                <thead>

                    <tr>
                        <th>Day</th>
                        <th>Opening Time</th>
                        <th>Closing Time</th>
                        <th>Closed</th>
                    </tr>

                </thead>


                <tbody>

                    @for (int i = 0;
                         i < Model.Hours.Count;
                         i++)
                    {
                        <tr>

                            <td>

                                <strong>
                                    @Model.Hours[i].Day
                                </strong>


                                <input asp-for="Hours[i].OperatingHourId"
                                       type="hidden" />


                                <input asp-for="Hours[i].Day"
                                       type="hidden" />

                            </td>


                            <td>

                                <input asp-for="Hours[i].OpeningTime"
                                       type="time"
                                       class="form-control operating-time"
                                       data-row="@i"
                                       data-type="opening" />


                                <span asp-validation-for="Hours[i].OpeningTime"
                                      class="text-danger small">
                                </span>

                            </td>


                            <td>

                                <input asp-for="Hours[i].ClosingTime"
                                       type="time"
                                       class="form-control operating-time"
                                       data-row="@i"
                                       data-type="closing" />


                                <span asp-validation-for="Hours[i].ClosingTime"
                                      class="text-danger small">
                                </span>

                            </td>


                            <td>

                                <div class="form-check form-switch">

                                    <input asp-for="Hours[i].IsClosed"
                                           class="form-check-input closed-toggle"
                                           data-row="@i" />


                                    <label asp-for="Hours[i].IsClosed"
                                           class="form-check-label">

                                        Closed

                                    </label>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <div class="d-flex justify-content-end mt-4">

            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-check-lg"></i>
                Save Operating Hours

            </button>

        </div>

    </form>

</div>


<div class="alert alert-light border mt-4">

    <i class="bi bi-info-circle me-2"></i>

    Closed days do not require opening or closing times.

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const toggles =
                    document.querySelectorAll(
                        ".closed-toggle"
                    );


                toggles.forEach(function (toggle) {

                    updateRow(toggle);


                    toggle.addEventListener(
                        "change",
                        function () {

                            updateRow(toggle);

                        }
                    );

                });


                function updateRow(toggle) {

                    const row =
                        toggle.dataset.row;


                    const opening =
                        document.querySelector(
                            `[data-row="${row}"][data-type="opening"]`
                        );


                    const closing =
                        document.querySelector(
                            `[data-row="${row}"][data-type="closing"]`
                        );


                    const isClosed =
                        toggle.checked;


                    opening.disabled =
                        isClosed;

                    closing.disabled =
                        isClosed;


                    if (isClosed) {

                        opening.value = "";
                        closing.value = "";

                    }

                }

            }
        );

    </script>
}