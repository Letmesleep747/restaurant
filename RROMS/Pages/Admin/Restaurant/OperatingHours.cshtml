@page
@model RROMS.Pages.Admin.Restaurant.OperatingHoursModel

@{
    ViewData["Title"] = "Operating Hours";
    Layout = "_AdminLayout";
}

<div class="page-heading">

    <div>
        <h2>Operating Hours</h2>

        <p>
            Configure restaurant opening and closing hours.
        </p>
    </div>

    <button class="btn btn-primary"
            type="button"
            disabled>

        <i class="bi bi-pencil"></i>
        Edit Hours

    </button>

</div>


<div class="content-card">

    <div class="content-card-header">

        <div>
            <h5>Weekly Operating Schedule</h5>

            <small class="text-muted">
                Restaurant operating hours by day
            </small>
        </div>

    </div>


    <div class="table-responsive">

        <table class="table admin-table">

            <thead>
                <tr>
                    <th>Day</th>
                    <th>Opening Time</th>
                    <th>Closing Time</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var hour in Model.OperatingHours)
                {
                    <tr>

                        <td>
                            <strong>@hour.Day</strong>
                        </td>

                        @if (hour.IsClosed)
                        {
                            <td>-</td>
                            <td>-</td>

                            <td>
                                <span class="status-badge inactive">
                                    Closed
                                </span>
                            </td>
                        }
                        else
                        {
                            <td>@hour.OpeningTime</td>

                            <td>@hour.ClosingTime</td>

                            <td>
                                <span class="status-badge active">
                                    Open
                                </span>
                            </td>
                        }

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>