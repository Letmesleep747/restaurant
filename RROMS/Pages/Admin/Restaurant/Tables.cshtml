@page
@model RROMS.Pages.Admin.Restaurant.TablesModel

@{
    ViewData["Title"] = "Tables";
}


<div class="page-heading">

    <div>
        <h2>Table Management</h2>

        <p>
            Manage restaurant tables, seating capacity and dining area assignments.
        </p>
    </div>

    <a asp-page="/Admin/Restaurant/CreateTable"
       class="btn btn-primary">

        <i class="bi bi-plus-lg"></i>
        Add Table

    </a>

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        <i class="bi bi-check-circle me-2"></i>

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">

        <i class="bi bi-exclamation-circle me-2"></i>

        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<div class="content-card">

    <div class="content-card-header">

        <div>
            <h5>Restaurant Tables</h5>

            <small class="text-muted">
                Current restaurant table configuration
            </small>
        </div>

        <span class="badge text-bg-light">
            @Model.RestaurantTables.Count Tables
        </span>

    </div>


    @if (Model.RestaurantTables.Count == 0)
    {
        <div class="text-center py-5">

            <i class="bi bi-layout-text-window fs-1 text-muted"></i>

            <h5 class="mt-3">
                No restaurant tables found
            </h5>

            <p class="text-muted">
                Add your first restaurant table.
            </p>

            <a asp-page="/Admin/Restaurant/CreateTable"
               class="btn btn-primary">

                <i class="bi bi-plus-lg"></i>
                Add Table

            </a>

        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table admin-table">

                <thead>

                    <tr>
                        <th>Table</th>
                        <th>Dining Area</th>
                        <th>Capacity</th>
                        <th>Status</th>
                        <th>Last Updated</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var table in Model.RestaurantTables)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @table.TableNumber
                                </strong>
                            </td>

                            <td>
                                @(table.DiningArea?.Name ?? "-")
                            </td>

                            <td>
                                @table.Capacity persons
                            </td>

                            <td>

                                @if (table.IsActive)
                                {
                                    <span class="status-badge active">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge inactive">
                                        Inactive
                                    </span>
                                }

                            </td>

                            <td>
                                @(table.UpdatedAt
                                    .ToLocalTime()
                                    .ToString("dd MMM yyyy, hh:mm tt"))
                            </td>

                            <td>

                                <div class="d-flex gap-2">

                                    <a asp-page="/Admin/Restaurant/EditTable"
                                       asp-route-id="@table.RestaurantTableId"
                                       class="btn btn-sm btn-outline-secondary">

                                        <i class="bi bi-pencil"></i>
                                        Edit

                                    </a>


                                    <form method="post"
                                          asp-page-handler="ToggleStatus"
                                          asp-route-id="@table.RestaurantTableId">

                                        @if (table.IsActive)
                                        {
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-warning">

                                                Deactivate

                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success">

                                                Activate

                                            </button>
                                        }

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>