
@page
@model RROMS.Pages.Admin.SystemSettings.IndexModel

@{
    ViewData["Title"] = "System Settings";
}

<div class="container-fluid py-3">
    <h2 class="fw-bold mb-1">System Settings</h2>
    <p class="text-muted mb-4">
        Manage basic restaurant information and default reservation settings.
    </p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <h5 class="fw-semibold mb-3">Restaurant Information</h5>

                <div class="mb-3">
                    <label asp-for="Setting.RestaurantName"
                           class="form-label">Restaurant Name</label>
                    <input asp-for="Setting.RestaurantName"
                           class="form-control" />
                    <span asp-validation-for="Setting.RestaurantName"
                          class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Setting.ContactEmail"
                               class="form-label">Contact Email</label>
                        <input asp-for="Setting.ContactEmail"
                               class="form-control" />
                        <span asp-validation-for="Setting.ContactEmail"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Setting.ContactPhone"
                               class="form-label">Contact Phone</label>
                        <input asp-for="Setting.ContactPhone"
                               class="form-control" />
                        <span asp-validation-for="Setting.ContactPhone"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Setting.Address"
                           class="form-label">Restaurant Address</label>
                    <textarea asp-for="Setting.Address"
                              class="form-control"
                              rows="3"></textarea>
                    <span asp-validation-for="Setting.Address"
                          class="text-danger"></span>
                </div>

                <hr class="my-4" />

                <h5 class="fw-semibold mb-3">Reservation Defaults</h5>

                <div class="mb-4">
                    <label asp-for="Setting.DefaultReservationDurationMinutes"
                           class="form-label">
                        Default Reservation Duration (minutes)
                    </label>
                    <input asp-for="Setting.DefaultReservationDurationMinutes"
                           type="number"
                           min="30"
                           max="240"
                           step="15"
                           class="form-control" />
                    <div class="form-text">
                        Enter a duration between 30 and 240 minutes.
                    </div>
                    <span asp-validation-for="Setting.DefaultReservationDurationMinutes"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i> Save Settings
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}