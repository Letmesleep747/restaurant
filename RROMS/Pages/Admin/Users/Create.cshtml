@page
@model RROMS.Pages.Admin.Users.CreateModel

@{
    ViewData["Title"] = "Add User";
}

<div class="page-heading">
    <div>
        <h2>Add User</h2>
        <p>Create a new Administrator, Restaurant Staff or Customer account.</p>
    </div>

    <a asp-page="./Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
        Back
    </a>
</div>

<div class="content-card">

    <div class="content-card-header">
        <div>
            <h5>Account Information</h5>
            <small class="text-muted">
                Enter the details below to create a new RROMS user account.
            </small>
        </div>
    </div>

    <form method="post" data-turbo="false">

        <!-- General validation messages -->
        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="row">

            <!-- Full Name -->
            <div class="col-md-6 mb-3">
                <label asp-for="Input.FullName" class="form-label"></label>

                <input asp-for="Input.FullName"
                       class="form-control"
                       placeholder="Enter full name" />

                <span asp-validation-for="Input.FullName"
                      class="text-danger">
                </span>
            </div>

            <!-- Email -->
            <div class="col-md-6 mb-3">
                <label asp-for="Input.Email" class="form-label"></label>

                <input asp-for="Input.Email"
                       class="form-control"
                       type="email"
                       placeholder="Enter email address" />

                <span asp-validation-for="Input.Email"
                      class="text-danger">
                </span>
            </div>

            <!-- Phone Number -->
            <div class="col-md-6 mb-3">
                <label asp-for="Input.PhoneNumber" class="form-label"></label>

                <input asp-for="Input.PhoneNumber"
                       class="form-control"
                       type="tel"
                       placeholder="Enter phone number (optional)" />

                <span asp-validation-for="Input.PhoneNumber"
                      class="text-danger">
                </span>
            </div>

            <!-- Role -->
            <div class="col-md-6 mb-3">
                <label asp-for="Input.Role" class="form-label"></label>

                <select asp-for="Input.Role" class="form-select">
                    <option value="">Select a role</option>
                    <option value="Administrator">Administrator</option>
                    <option value="RestaurantStaff">Restaurant Staff</option>
                    <option value="Customer">Customer</option>
                </select>

                <span asp-validation-for="Input.Role"
                      class="text-danger">
                </span>
            </div>

            <!-- Password -->
            <div class="col-md-6 mb-3">
                <label asp-for="Input.Password" class="form-label"></label>

                <input asp-for="Input.Password"
                       class="form-control"
                       type="password"
                       placeholder="Enter password"
                       autocomplete="new-password" />

                <span asp-validation-for="Input.Password"
                      class="text-danger">
                </span>

                <small class="text-muted">
                    Password must contain at least 8 characters.
                </small>
            </div>

            <!-- Confirm Password -->
            <div class="col-md-6 mb-3">
                <label asp-for="Input.ConfirmPassword"
                       class="form-label">
                </label>

                <input asp-for="Input.ConfirmPassword"
                       class="form-control"
                       type="password"
                       placeholder="Confirm password"
                       autocomplete="new-password" />

                <span asp-validation-for="Input.ConfirmPassword"
                      class="text-danger">
                </span>
            </div>

        </div>

        <!-- Form Buttons -->
        <div class="mt-3">

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-person-plus"></i>
                Create User
            </button>

            <a asp-page="./Index"
               class="btn btn-outline-secondary ms-2">
                Cancel
            </a>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
