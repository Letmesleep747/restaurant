@page "{id}"
@model RROMS.Pages.Admin.Users.EditModel

@{
    ViewData["Title"] = "Edit User";
}

<div class="page-heading">

    <div>

        <h2>Edit User</h2>

        <p>
            Update account information and permissions.
        </p>

    </div>

    <a asp-page="./Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left"></i>
        Back

    </a>

</div>


<div class="content-card">

    <div class="content-card-header">

        <div>

            <h5>Account Information</h5>

            <small class="text-muted">
                Update the selected account.
            </small>

        </div>

    </div>


    <form method="post">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>


        <input asp-for="Input.Id"
               type="hidden" />


        <div class="row">

            <div class="col-md-6 mb-3">

                <label asp-for="Input.FullName"
                       class="form-label">
                </label>

                <input asp-for="Input.FullName"
                       class="form-control" />

                <span asp-validation-for="Input.FullName"
                      class="text-danger">
                </span>

            </div>


            <div class="col-md-6 mb-3">

                <label asp-for="Input.Email"
                       class="form-label">
                </label>

                <input asp-for="Input.Email"
                       class="form-control" />

                <span asp-validation-for="Input.Email"
                      class="text-danger">
                </span>

            </div>


            <div class="col-md-6 mb-3">

                <label asp-for="Input.PhoneNumber"
                       class="form-label">
                </label>

                <input asp-for="Input.PhoneNumber"
                       class="form-control" />

                <span asp-validation-for="Input.PhoneNumber"
                      class="text-danger">
                </span>

            </div>


            <div class="col-md-6 mb-3">

                <label asp-for="Input.Role"
                       class="form-label">
                </label>

                <select asp-for="Input.Role"
                        class="form-select"
                        disabled="@Model.IsEditingCurrentUser">

                    <option value="RestaurantStaff">
                        Restaurant Staff
                    </option>

                    <option value="Customer">
                        Customer
                    </option>

                    <option value="Administrator">
                        Administrator
                    </option>

                </select>

                @if (Model.IsEditingCurrentUser)
                {
                    <div class="form-text">
                        Your own Administrator role cannot be changed.
                    </div>
                }

            </div>


            <div class="col-md-6 mb-3">

                <div class="form-check form-switch">

                    <input asp-for="Input.IsActive"
                           class="form-check-input"
                           disabled="@Model.IsEditingCurrentUser" />

                    <label asp-for="Input.IsActive"
                           class="form-check-label">
                    </label>

                </div>


                @if (Model.IsEditingCurrentUser)
                {
                    <div class="form-text">
                        Your own account cannot be deactivated.
                    </div>
                }

            </div>

        </div>


        <div class="mt-3">

            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-check-lg"></i>
                Save Changes

            </button>


            <a asp-page="./Index"
               class="btn btn-outline-secondary ms-2">

                Cancel

            </a>

        </div>

    </form>

</div>