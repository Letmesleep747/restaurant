
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    string ActiveClass(string pagePath)
    {
        return string.Equals(
            currentPage,
            pagePath,
            StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RROMS Admin</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />
</head>

<body>
    <div class="admin-wrapper">

        <!-- Sidebar -->
        <aside class="admin-sidebar" id="adminSidebar">

            <!-- Brand -->
            <div class="sidebar-header">
                <div class="brand-icon">
                    <i class="bi bi-shop"></i>
                </div>

                <div>
                    <h5>RROMS</h5>
                    <small>Administrator</small>
                </div>
            </div>

            <!-- Navigation -->
            <nav class="sidebar-nav" aria-label="Admin navigation">

                <!-- Dashboard -->
                <a asp-page="/Admin/Index"
                   class="sidebar-link @ActiveClass("/Admin/Index")">
                    <i class="bi bi-grid"></i>
                    <span>Dashboard</span>
                </a>

                <!-- Restaurant -->
                <div class="sidebar-section-title">
                    RESTAURANT
                </div>

                <a asp-page="/Admin/Restaurant/DiningAreas"
                   class="sidebar-link @ActiveClass("/Admin/Restaurant/DiningAreas")">
                    <i class="bi bi-building"></i>
                    <span>Dining Areas</span>
                </a>

                <a asp-page="/Admin/Restaurant/Tables"
                   class="sidebar-link @ActiveClass("/Admin/Restaurant/Tables")">
                    <i class="bi bi-layout-text-window"></i>
                    <span>Tables</span>
                </a>

                <a asp-page="/Admin/Restaurant/OperatingHours"
                   class="sidebar-link @ActiveClass("/Admin/Restaurant/OperatingHours")">
                    <i class="bi bi-clock"></i>
                    <span>Operating Hours</span>
                </a>

                <!-- Management -->
                <div class="sidebar-section-title">
                    MANAGEMENT
                </div>

                <a asp-page="/Admin/Users/Index"
                   class="sidebar-link @ActiveClass("/Admin/Users/Index")">
                    <i class="bi bi-people"></i>
                    <span>User Management</span>
                </a>

                <a asp-page="/Admin/Menu/Categories/Index"
                   class="sidebar-link @ActiveClass("/Admin/Menu/Categories/Index")">
                    <i class="bi bi-folder2-open"></i>
                    <span>Menu Categories</span>
                </a>

                <a asp-page="/Admin/Menu/Items/Index"
                   class="sidebar-link @ActiveClass("/Admin/Menu/Items/Index")">
                    <i class="bi bi-egg-fried"></i>
                    <span>Menu Items</span>
                </a>

                <a asp-page="/Admin/Promotions/Index"
                   class="sidebar-link @ActiveClass("/Admin/Promotions/Index")">
                    <i class="bi bi-tags"></i>
                    <span>Promotions &amp; Discounts</span>
                </a>

                <a asp-page="/Admin/Announcements/Index"
                   class="sidebar-link @ActiveClass("/Admin/Announcements/Index")">
                    <i class="bi bi-megaphone"></i>
                    <span>Announcements</span>
                </a>

                <!-- Operations -->
                <div class="sidebar-section-title">
                    OPERATIONS
                </div>

                <a asp-page="/Admin/Reservations/Index"
                   class="sidebar-link @ActiveClass("/Admin/Reservations/Index")">
                    <i class="bi bi-calendar-check"></i>
                    <span>Reservation Monitoring</span>
                </a>

                <a asp-page="/Admin/Orders/Index"
                   class="sidebar-link @ActiveClass("/Admin/Orders/Index")">
                    <i class="bi bi-receipt"></i>
                    <span>Order Monitoring</span>
                </a>

                <a href="#"
                   class="sidebar-link disabled-link"
                   aria-disabled="true"
                   tabindex="-1">
                    <i class="bi bi-credit-card"></i>
                    <span>Payment Monitoring</span>
                    <span class="ms-auto small">Soon</span>
                </a>

                <!-- Analytics -->
                <div class="sidebar-section-title">
                    ANALYTICS
                </div>

                <a asp-page="/Admin/Reports/Index"
                   class="sidebar-link @ActiveClass("/Admin/Reports/Index")">
                    <i class="bi bi-bar-chart-line"></i>
                    <span>Reports &amp; Analytics</span>
                </a>

                <!-- System -->
                <div class="sidebar-section-title">
                    SYSTEM
                </div>

                <a asp-page="/Admin/SystemSettings/Index"
                   class="sidebar-link @ActiveClass("/Admin/SystemSettings/Index")">
                    <i class="bi bi-gear"></i>
                    <span>System Settings</span>
                </a>

            </nav>
        </aside>

        <!-- Main Area -->
        <div class="admin-main">

            <!-- Top Navbar -->
            <header class="admin-topbar">

                <div class="d-flex align-items-center gap-3">

                    <button class="sidebar-toggle"
                            type="button"
                            id="sidebarToggle"
                            aria-label="Toggle sidebar"
                            aria-controls="adminSidebar"
                            aria-expanded="true">
                        <i class="bi bi-list"></i>
                    </button>

                    <div>
                        <h6 class="mb-0">
                            @(ViewData["Title"] ?? "Dashboard")
                        </h6>

                        <small class="text-muted">
                            Restaurant Reservation &amp; Order Management System
                        </small>
                    </div>

                </div>

                <!-- Admin Profile -->
                <div class="admin-profile">

                    <div class="profile-icon">
                        <i class="bi bi-person"></i>
                    </div>

                    <div class="profile-text">
                        <span>
                            @(User.Identity?.Name ?? "Administrator")
                        </span>

                        <small>
                            Administrator
                        </small>
                    </div>

                    <!-- Logout -->
                    <form method="post"
                          asp-page="/Account/Logout"
                          class="ms-2">
                        <button type="submit"
                                class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Logout</span>
                        </button>
                    </form>

                </div>
            </header>

            <!-- Page Content -->
            <main class="admin-content" id="mainContent">
                @RenderBody()
            </main>

        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/admin.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>