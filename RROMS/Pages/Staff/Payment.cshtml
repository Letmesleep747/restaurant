@page
@model RROMS.Pages.Staff.PaymentModel

@{
    ViewData["Title"] = "Payment Management";
}

<style>
    .payment-header {
        background: #243447;
        color: white;
        padding: 25px;
        border-radius: 10px;
        margin-bottom: 25px;
    }

    .payment-card {
        border: none;
        border-radius: 12px;
    }

    .payment-stat {
        font-size: 28px;
        font-weight: bold;
    }

    .action-buttons button {
        margin: 2px;
    }

    .table th {
        white-space: nowrap;
    }
</style>

<div class="container mt-4 mb-5">

    <!-- Header -->
    <div class="payment-header">
        <h2>Payment Management</h2>
        <p class="mb-0">
            Monitor customer bills and payment status.
        </p>
    </div>

    
    <!-- Staff Navigation -->
    <div class="d-flex flex-wrap gap-2 mb-4">

        <a asp-page="/Staff/Dashboard"
           class="btn btn-outline-dark">
            Dashboard
        </a>

        <a asp-page="/Staff/Reservations"
           class="btn btn-outline-primary">
            Reservations
        </a>

        <a asp-page="/Staff/Order"
           class="btn btn-outline-success">
            Orders
        </a>

        <a asp-page="/Staff/Payment"
           class="btn btn-outline-warning">
            Payments
        </a>

    </div>


    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card payment-card shadow-sm">
                <div class="card-body">
                    <h6>Total Bills</h6>
                    <div class="payment-stat"
                         id="totalBills">
                        0
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card payment-card shadow-sm">
                <div class="card-body">
                    <h6>Unpaid Bills</h6>
                    <div class="payment-stat text-danger"
                         id="unpaidBills">
                        0
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card payment-card shadow-sm">
                <div class="card-body">
                    <h6>Total Collected</h6>
                    <div class="payment-stat text-success">
                        RM <span id="totalCollected">0.00</span>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Search and Filter -->
    <div class="card payment-card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">

                <div class="col-md-6">
                    <label class="form-label">
                        Search Payments
                    </label>

                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           placeholder="Bill ID, order ID, customer, table..."
                           oninput="renderPayments()" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">
                        Payment Status
                    </label>

                    <select id="statusFilter"
                            class="form-select"
                            onchange="renderPayments()">
                        <option value="All">All Status</option>
                        <option value="Unpaid">Unpaid</option>
                        <option value="Paid">Paid</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <a asp-page="/Staff/Orders"
                       class="btn btn-outline-primary w-100">
                        View Orders
                    </a>
                </div>

            </div>
        </div>
    </div>

    <!-- Payment Table -->
    <div class="card payment-card shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0">Customer Bills</h5>
        </div>

        <div class="card-body">
            <div class="table-responsive">

                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Bill ID</th>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Table</th>
                            <th>Total (RM)</th>
                            <th>Status</th>
                            <th>Payment Method</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody id="paymentTableBody"></tbody>
                </table>

            </div>

            <p id="emptyMessage"
               class="text-center text-muted d-none">
                No bills found.
            </p>
        </div>
    </div>

</div>

<!-- View Bill Modal -->
<div class="modal fade"
     id="viewBillModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Bill Details</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body" id="billDetails"></div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>

<!-- Record Payment Modal -->
<div class="modal fade"
     id="paymentModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Record Payment</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <form id="paymentForm">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <input type="hidden" id="paymentBillId" />

                    <p>
                        <strong>Bill:</strong>
                        <span id="selectedBillId"></span>
                    </p>

                    <p>
                        <strong>Amount:</strong>
                        RM <span id="selectedAmount"></span>
                    </p>

                    <div class="mb-3">
                        <label class="form-label">
                            Payment Method
                        </label>

                        <select id="paymentMethod"
                                class="form-select"
                                required>
                            <option value="">Select Payment Method</option>
                            <option value="Cash">Cash</option>
                            <option value="Card">Card</option>
                            <option value="E-Wallet">E-Wallet</option>
                        </select>
                    </div>

                    <div class="alert alert-info mb-0">
                        This records the payment method and payment status in the system.
                        No external payment gateway is connected.
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-success">
                        Confirm Payment
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>

        let payments = [];

        function calculateTotal(payment) {
            return Number(payment.amount || 0);
        }

        function formatBillId(id) {
            return "BILL" + String(id).padStart(3, "0");
        }

        function formatOrderId(id) {
            return "ORD" + String(id).padStart(3, "0");
        }

        async function loadPayments() {
            try {
                const response = await fetch("?handler=List");
                const data = await response.json();

                if (!response.ok || !data.success) {
                    throw new Error(data.message || "Unable to load payments.");
                }

                payments = data.payments;
                renderPayments();
            }
            catch (error) {
                console.error(error);
                alert("Unable to load payment records from the database.");
            }
        }
        
        const viewBillModal = new bootstrap.Modal(
            document.getElementById("viewBillModal")
        );

        const paymentModal = new bootstrap.Modal(
            document.getElementById("paymentModal")
        );

        function renderPayments() {
            const search = document.getElementById("searchInput")
                .value.trim().toLowerCase();

            const filter = document.getElementById("statusFilter").value;
            const tbody = document.getElementById("paymentTableBody");

            tbody.innerHTML = "";

            const filtered = payments.filter(p => {
                const billId = formatBillId(p.id).toLowerCase();
                const orderId = formatOrderId(p.orderId).toLowerCase();
                const tableText = String(p.table).toLowerCase();

                const matchesSearch =
                    billId.includes(search) ||
                    orderId.includes(search) ||
                    p.customer.toLowerCase().includes(search) ||
                    tableText.includes(search) ||
                    String(p.table).includes(search);

                const matchesStatus =
                    filter === "All" || p.status === filter;

                return matchesSearch && matchesStatus;
            });

            filtered.forEach(p => {
                const row = document.createElement("tr");

                const values = [
                    formatBillId(p.id),
                    formatOrderId(p.orderId),
                    p.customer,
                    p.table === "Walk-in" || p.table === "Not Assigned"
                        ? p.table
                        : "Table " + p.table,
                    calculateTotal(p).toFixed(2)
                ];

                values.forEach(value => {
                    const cell = document.createElement("td");
                    cell.textContent = value;
                    row.appendChild(cell);
                });

                const statusCell = document.createElement("td");
                const badge = document.createElement("span");

                badge.className = p.status === "Paid"
                    ? "badge bg-success"
                    : "badge bg-danger";

                badge.textContent = p.status;
                statusCell.appendChild(badge);
                row.appendChild(statusCell);

                const methodCell = document.createElement("td");
                methodCell.textContent = p.method;
                row.appendChild(methodCell);

                const actionCell = document.createElement("td");
                actionCell.className = "action-buttons";

                const viewButton = document.createElement("button");
                viewButton.type = "button";
                viewButton.className = "btn btn-sm btn-outline-info";
                viewButton.textContent = "View Bill";
                viewButton.addEventListener("click", () => viewBill(p.id));
                actionCell.appendChild(viewButton);

                if (p.status === "Unpaid") {
                    const payButton = document.createElement("button");
                    payButton.type = "button";
                    payButton.className = "btn btn-sm btn-success";
                    payButton.textContent = "Record Payment";
                    payButton.addEventListener("click",
                        () => openPaymentModal(p.id));
                    actionCell.appendChild(payButton);
                }

                row.appendChild(actionCell);
                tbody.appendChild(row);
            });

            document.getElementById("emptyMessage")
                .classList.toggle("d-none", filtered.length > 0);

            document.getElementById("totalBills").textContent =
                payments.length;

            document.getElementById("unpaidBills").textContent =
                payments.filter(p => p.status === "Unpaid").length;

            const collected = payments
                .filter(p => p.status === "Paid")
                .reduce((sum, p) => sum + calculateTotal(p), 0);

            document.getElementById("totalCollected").textContent =
                collected.toFixed(2);
        }

        function viewBill(id) {
            const bill = payments.find(p => p.id === id);
            if (!bill) return;

            const container = document.getElementById("billDetails");
            container.innerHTML = "";

            function addDetail(label, value) {
                const p = document.createElement("p");
                const strong = document.createElement("strong");

                strong.textContent = label + ": ";
                p.append(strong, document.createTextNode(value));

                container.appendChild(p);
            }

            addDetail("Bill ID", formatBillId(bill.id));
            addDetail("Order ID", formatOrderId(bill.orderId));
            addDetail("Customer", bill.customer);

            addDetail(
                "Table",
                bill.table === "Walk-in" ||
                bill.table === "Not Assigned"
                    ? bill.table
                    : "Table " + bill.table
            );

            addDetail("Status", bill.status);
            addDetail("Payment Method", bill.method);

            const heading = document.createElement("h6");
            heading.textContent = "Ordered Items";
            container.appendChild(heading);

            const list = document.createElement("ul");

            bill.items.forEach(item => {
                const li = document.createElement("li");

                const itemTotal =
                    Number(item.price) * Number(item.quantity);

                li.textContent =
                    item.name + " x " + item.quantity +
                    " - RM " + itemTotal.toFixed(2);

                list.appendChild(li);
            });

            container.appendChild(list);

            addDetail(
                "Total Amount",
                "RM " + calculateTotal(bill).toFixed(2)
            );

            if (bill.transactionDate) {
                addDetail(
                    "Transaction Date",
                    new Date(bill.transactionDate).toLocaleString()
                );
            }

            viewBillModal.show();
        }

        function openPaymentModal(id) {
            const bill = payments.find(p => p.id === id);
            if (!bill || bill.status !== "Unpaid") return;

            document.getElementById("paymentForm").reset();
            document.getElementById("paymentBillId").value = bill.id;
            document.getElementById("selectedBillId").textContent =
                formatBillId(bill.id);
            document.getElementById("selectedAmount").textContent =
                calculateTotal(bill).toFixed(2);

            paymentModal.show();
        }

        document.getElementById("paymentForm")
            .addEventListener("submit", async function (event) {
                event.preventDefault();

                const paymentId = Number(
                    document.getElementById("paymentBillId").value
                );

                const method =
                    document.getElementById("paymentMethod").value;

                if (!method) {
                    alert("Please select a payment method.");
                    return;
                }

                const bill = payments.find(p => p.id === paymentId);

                if (!bill || bill.status !== "Unpaid") {
                    alert("This bill is no longer available for payment.");
                    return;
                }

                try {
                    const response = await fetch("?handler=RecordPayment", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "RequestVerificationToken":
                                document.querySelector(
                                    'input[name="__RequestVerificationToken"]'
                                ).value
                        },
                        body: JSON.stringify({
                            paymentId: paymentId,
                            method: method
                        })
                    });

                    const data = await response.json();

                    if (!response.ok || !data.success) {
                        alert(data.message || "Payment could not be recorded.");
                        return;
                    }

                    paymentModal.hide();

                    await loadPayments();

                    alert(
                        "Payment recorded successfully!\n" +
                        "Order " + formatOrderId(data.orderId) +
                        " has automatically changed to Completed."
                    );
                }
                catch (error) {
                    console.error(error);
                    alert("An error occurred while recording the payment.");
                }
            });

        loadPayments();
    </script>
}
