@page
@model RROMS.Pages.Staff.ReservationsModel

@{
    ViewData["Title"] = "Reservation Management";
}

<style>
    .reservation-header {
        background: #243447;
        color: white;
        padding: 25px;
        border-radius: 10px;
        margin-bottom: 25px;
    }

    .reservation-card {
        border: none;
        border-radius: 12px;
    }

    .action-buttons button {
        margin: 2px;
    }

    .table th {
        white-space: nowrap;
    }
</style>

<div class="container mt-4 mb-5">

    <div class="reservation-header">
        <h2>Reservation Management</h2>
        <p class="mb-0">
            Manage customer bookings and table reservations.
        </p>
    </div>

    <!-- Staff Navigation -->
    <div class="d-flex flex-wrap gap-2 mb-4">

        <a asp-page="/Staff/Dashboard"
           class="btn btn-outline-dark">
            Dashboard
        </a>

        <a asp-page="/Staff/Reservations"
           class="btn btn-outline-primary">
            Reservations
        </a>

        <a asp-page="/Staff/Order"
           class="btn btn-outline-success">
            Orders
        </a>

        <a asp-page="/Staff/Payment"
           class="btn btn-outline-warning">
            Payments
        </a>

    </div>

    <!-- Search and Add Reservation -->
    <div class="card reservation-card shadow-sm mb-4">
        <div class="card-body">

            <div class="row g-3 align-items-end">

                <div class="col-md-5">
                    <label class="form-label">
                        Search Reservations
                    </label>

                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           placeholder="Search customer or phone..."
                           oninput="renderReservations()" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">
                        Filter by Status
                    </label>

                    <select id="statusFilter"
                            class="form-select"
                            onchange="renderReservations()">
                        <option value="All">All Status</option>
                        <option value="Pending">Pending</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>

                <div class="col-md-4 text-md-end">
                    <button type="button"
                            class="btn btn-primary"
                            onclick="openAddModal()">
                        + Add Reservation
                    </button>
                </div>

            </div>

        </div>
    </div>

    <!-- Reservation Table -->
    <div class="card reservation-card shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0">Customer Reservations</h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Customer</th>
                            <th>Phone</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Guests</th>
                            <th>Table</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody id="reservationTableBody">
                    </tbody>

                </table>
            </div>

            <p id="loadingMessage"
               class="text-center text-muted">
                Loading reservations...
            </p>

            <p id="emptyMessage"
               class="text-center text-muted d-none">
                No reservations found.
            </p>

        </div>
    </div>

</div>

<!-- Add / Edit Reservation Modal -->
<div class="modal fade"
     id="reservationModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">
                    Add Reservation
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <form id="reservationForm">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <input type="hidden" id="reservationId" />

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">Customer Name</label>

                            <div class="position-relative">
                                <input type="text"
                                       id="customerSearch"
                                       class="form-control"
                                       placeholder="Search or select customer..."
                                       autocomplete="off"
                                       required />

                                <div id="customerSuggestions"
                                     class="list-group position-absolute w-100 shadow-sm"
                                     style="z-index: 1055; max-height: 200px; overflow-y: auto; display: none;">
                                </div>
                            </div>

                            <input type="hidden" id="customerId" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Phone Number
                            </label>

                            <input type="tel"
                                   id="phoneNumber"
                                   class="form-control"
                                   readonly
                                   placeholder="Customer phone number" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Reservation Date
                            </label>

                            <input type="date"
                                   id="reservationDate"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Reservation Time
                            </label>

                            <input type="time"
                                   id="reservationTime"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Number of Guests
                            </label>

                            <input type="number"
                                   id="numberOfGuests"
                                   class="form-control"
                                   min="1"
                                   max="20"
                                   required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Table
                            </label>

                            <select id="tableId"
                                    class="form-select">
                                <option value="">
                                    Not assigned
                                </option>
                            </select>

                            <small class="text-muted">
                                Only active restaurant tables are listed.
                            </small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Reservation Status
                            </label>

                            <select id="reservationStatus"
                                    class="form-select">
                                <option value="Pending">Pending</option>
                                <option value="Confirmed">Confirmed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Special Requests
                            </label>

                            <textarea id="specialRequests"
                                      class="form-control"
                                      rows="2"
                                      maxlength="500"
                                      placeholder="Optional special requests..."></textarea>
                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Close
                    </button>

                    <button type="submit"
                            id="saveReservationButton"
                            class="btn btn-primary">
                        Save Reservation
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {

    <script>
        // ==========================================
        // DATABASE DATA
        // ==========================================

        let reservations = [];
        let customers = [];
        let tables = [];

        const modalElement =
            document.getElementById("reservationModal");

        const reservationModal =
            new bootstrap.Modal(modalElement);

        const reservationForm =
            document.getElementById("reservationForm");

        const saveButton =
            document.getElementById("saveReservationButton");

        const pageUrl = window.location.pathname;

        // ==========================================
        // API HELPER
        // ==========================================

        async function getJson(url) {

            const response = await fetch(url);

            const result = await response.json();

            if (!response.ok || result.success === false) {
                throw new Error(
                    result.message || "Unable to retrieve data."
                );
            }

            return result;
        }

        async function postJson(handler, data) {

            const tokenInput = document.querySelector(
                'input[name="__RequestVerificationToken"]'
            );

            if (!tokenInput) {
                throw new Error(
                    "Security token not found. Please refresh the page."
                );
            }

            const response = await fetch(
                `${pageUrl}?handler=${handler}`,
                {
                    method: "POST",

                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": tokenInput.value
                    },

                    body: JSON.stringify(data)
                }
            );

            const result = await response.json();

            if (!response.ok || result.success === false) {
                throw new Error(
                    result.message || "The operation failed."
                );
            }

            return result;
        }

        // ==========================================
        // LOAD DATABASE DATA
        // ==========================================

        async function loadReservations() {

            try {

                document.getElementById("loadingMessage")
                    .classList.remove("d-none");

                document.getElementById("emptyMessage")
                    .classList.add("d-none");

                const result = await getJson(
                    `${pageUrl}?handler=List`
                );

                reservations = result.data || [];

                renderReservations();

            } catch (error) {

                console.error(error);

                alert(
                    "Unable to load reservations: " + error.message
                );

            } finally {

                document.getElementById("loadingMessage")
                    .classList.add("d-none");

            }
        }

        async function loadOptions() {
            try {
                const result = await getJson(`${pageUrl}?handler=Options`);

                customers = result.customers || [];
                tables = result.tables || [];

                // Customer suggestions use the customers array directly.
                // No populateCustomers() function is needed anymore.
                populateTables();

            } catch (error) {
                console.error(error);
                alert("Unable to load customers and tables: " + error.message);
            }
        }

            async function initializePage() {

                await Promise.all([
                    loadOptions(),
                    loadReservations()
                ]);

            }

        // ==========================================
        // SINGLE-BOX CUSTOMER SEARCH AND SELECTION
        // ==========================================

        const customerSearch = document.getElementById("customerSearch");
        const customerSuggestions =
            document.getElementById("customerSuggestions");

        const customerIdInput = document.getElementById("customerId");
        const phoneNumberInput = document.getElementById("phoneNumber");

        function showCustomerSuggestions() {

            const search = customerSearch.value.trim().toLowerCase();

            customerSuggestions.innerHTML = "";

            const filteredCustomers = customers.filter(customer =>
                (customer.name || "").toLowerCase().includes(search)
            );

            if (filteredCustomers.length === 0) {

                const empty = document.createElement("div");

                empty.className = "list-group-item text-muted";
                empty.textContent = "No matching customers found";

                customerSuggestions.appendChild(empty);

            } else {

                filteredCustomers.forEach(customer => {

                    const option = document.createElement("button");

                    option.type = "button";
                    option.className = "list-group-item list-group-item-action";
                    option.textContent = customer.name;

                    option.addEventListener("click", function () {

                        customerSearch.value = customer.name;
                        customerIdInput.value = customer.id;
                        phoneNumberInput.value = customer.phone || "";

                        customerSuggestions.style.display = "none";

                    });

                    customerSuggestions.appendChild(option);

                });

            }

            customerSuggestions.style.display = "block";
        }

        customerSearch.addEventListener("focus", showCustomerSuggestions);

        customerSearch.addEventListener("input", function () {

            // Clear previous selection when staff changes the name
            customerIdInput.value = "";
            phoneNumberInput.value = "";

            showCustomerSuggestions();

        });

        document.addEventListener("click", function (event) {

            if (!customerSearch.contains(event.target) &&
                !customerSuggestions.contains(event.target)) {

                customerSuggestions.style.display = "none";

            }

        });

        // ==========================================
        // TABLE DROPDOWN
        // ==========================================

        function populateTables(selectedTableId = "") {

            const select =
                document.getElementById("tableId");

            select.innerHTML = "";

            const defaultOption =
                document.createElement("option");

            defaultOption.value = "";
            defaultOption.textContent = "Not assigned";

            select.appendChild(defaultOption);

            tables.forEach(table => {

                const option =
                    document.createElement("option");

                option.value = table.id;

                option.textContent =
                    `Table ${table.tableNumber} (Capacity: ${table.capacity})`;

                select.appendChild(option);

            });

            select.value = selectedTableId || "";

        }

        // ==========================================
        // RENDER RESERVATIONS
        // ==========================================

        function renderReservations() {

            const search = document.getElementById("searchInput")
                .value.trim().toLowerCase();

            const filter = document.getElementById("statusFilter")
                .value;

            const tbody =
                document.getElementById("reservationTableBody");

            tbody.innerHTML = "";

            const filtered = reservations.filter(r => {

                const customerName =
                    (r.customer || "").toLowerCase();

                const phone =
                    (r.phone || "").toLowerCase();

                const matchesSearch =
                    customerName.includes(search) ||
                    phone.includes(search);

                const matchesStatus =
                    filter === "All" || r.status === filter;

                return matchesSearch && matchesStatus;

            });

            filtered.forEach(r => {

                const row = document.createElement("tr");

                const fields = [
                    r.id,
                    r.customer,
                    r.phone,
                    r.date,
                    r.time,
                    r.guests,
                    r.table === "Not assigned"
                        ? "Not assigned"
                        : "Table " + r.table
                ];

                fields.forEach(value => {

                    const cell = document.createElement("td");

                    cell.textContent = value ?? "";

                    row.appendChild(cell);

                });

                // Status badge
                const statusCell = document.createElement("td");

                const badge = document.createElement("span");

                badge.className = "badge " + (
                    r.status === "Confirmed"
                        ? "bg-success"
                        : r.status === "Pending"
                            ? "bg-warning text-dark"
                            : "bg-danger"
                );

                badge.textContent = r.status;

                statusCell.appendChild(badge);
                row.appendChild(statusCell);

                // Action buttons
                const actionsCell =
                    document.createElement("td");

                actionsCell.className = "action-buttons";

                function addButton(label, cssClass, action) {

                    const button =
                        document.createElement("button");

                    button.type = "button";
                    button.className =
                        "btn btn-sm " + cssClass;

                    button.textContent = label;

                    button.addEventListener("click", action);

                    actionsCell.appendChild(button);

                }

                addButton(
                    "Edit",
                    "btn-outline-primary",
                    () => editReservation(r.id)
                );

                if (r.status === "Pending") {

                    addButton(
                        "Confirm",
                        "btn-success",
                        () => updateStatus(r.id, "Confirmed")
                    );

                }

                if (r.status !== "Cancelled") {

                    addButton(
                        "Cancel",
                        "btn-outline-danger",
                        () => cancelReservation(r.id)
                    );

                }

                row.appendChild(actionsCell);

                tbody.appendChild(row);

            });

            document.getElementById("emptyMessage")
                .classList.toggle(
                    "d-none",
                    filtered.length > 0
                );

        }

        // ==========================================
        // ADD RESERVATION
        // ==========================================

        function openAddModal() {

            reservationForm.reset();

            document.getElementById("reservationId").value = "";

            document.getElementById("modalTitle").textContent =
                "Add Reservation";

            document.getElementById("reservationStatus").value =
                "Pending";

            // Reset customer search and selection
            document.getElementById("customerSearch").value = "";
            document.getElementById("customerId").value = "";
            document.getElementById("phoneNumber").value = "";

            document.getElementById("customerSuggestions").style.display = "none";

            populateTables();

            reservationModal.show();

        }

        // ==========================================
        // EDIT RESERVATION
        // ==========================================

        function editReservation(id) {

            const r = reservations.find(x => x.id === id);

            if (!r) return;

            document.getElementById("reservationId").value = r.id;

            // Find the existing customer
            const existingCustomer = customers.find(
                customer => String(customer.id) === String(r.customerId)
            );

            // Display customer name in the search box
            document.getElementById("customerSearch").value =
                existingCustomer ? existingCustomer.name : "";

            // Keep the actual customer ID for saving
            document.getElementById("customerId").value =
                existingCustomer ? existingCustomer.id : "";

            // Display customer phone number
            document.getElementById("phoneNumber").value =
                existingCustomer ? existingCustomer.phone || "" : "";

            document.getElementById("customerSuggestions").style.display =
                "none";

            document.getElementById("reservationDate").value =
                r.date;

            document.getElementById("reservationTime").value =
                r.time;

            document.getElementById("numberOfGuests").value =
                r.guests;

            document.getElementById("reservationStatus").value =
                r.status;

            document.getElementById("specialRequests").value =
                r.specialRequests || "";

            populateTables(r.tableId);

            document.getElementById("modalTitle").textContent =
                "Edit Reservation";

            reservationModal.show();

        }

        // ==========================================
        // SAVE RESERVATION
        // ==========================================

        reservationForm.addEventListener("submit", async function (event) {

            event.preventDefault();

            const idValue =
                document.getElementById("reservationId").value;

            const timeValue =
                document.getElementById("reservationTime").value;

            const data = {

                id: idValue ? Number(idValue) : 0,

                customerId:
                    document.getElementById("customerId").value,

                tableId:
                    document.getElementById("tableId").value
                        ? Number(document.getElementById("tableId").value)
                        : null,

                reservationDate:
                    document.getElementById("reservationDate").value,

                startTime:
                    timeValue ? timeValue + ":00" : "",

                partySize:
                    Number(document.getElementById("numberOfGuests").value),

                durationMinutes: 120,

                status:
                    document.getElementById("reservationStatus").value,

                specialRequests:
                    document.getElementById("specialRequests").value.trim()

            };

            if (!data.customerId) {
                alert("Please select a customer.");
                return;
            }

            if (!data.reservationDate || !timeValue) {
                alert("Please select a reservation date and time.");
                return;
            }

            try {

                saveButton.disabled = true;
                saveButton.textContent = "Saving...";

                const handler = idValue ? "Update" : "Add";

                const result = await postJson(handler, data);

                alert(result.message);

                reservationModal.hide();

                await loadReservations();

            } catch (error) {

                console.error(error);

                alert(
                    "Unable to save reservation: " + error.message
                );

            } finally {

                saveButton.disabled = false;
                saveButton.textContent = "Save Reservation";

            }

        });

        // ==========================================
        // UPDATE RESERVATION STATUS
        // ==========================================

        async function updateStatus(id, status) {

            try {

                const result = await postJson(
                    "UpdateStatus",
                    {
                        id: id,
                        status: status
                    }
                );

                alert(result.message);

                await loadReservations();

            } catch (error) {

                console.error(error);

                alert(
                    "Unable to update reservation: " + error.message
                );

            }

        }

        // ==========================================
        // CANCEL RESERVATION
        // ==========================================

        function cancelReservation(id) {

            if (!confirm(
                "Are you sure you want to cancel this reservation?"
            )) {
                return;
            }

            updateStatus(id, "Cancelled");

        }

        // ==========================================
        // START PAGE
        // ==========================================

        initializePage();

    </script>
}
