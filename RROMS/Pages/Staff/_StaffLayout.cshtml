
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var pageTitle = currentPage switch
    {
        "/Staff/Dashboard" => "Dashboard",
        "/Staff/Reservations" => "Reservation Management",
        "/Staff/Order" => "Order Management",
        "/Staff/Payment" => "Payment Management",
        _ => "Restaurant Staff"
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle - RROMS</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/RROMS.styles.css"
          asp-append-version="true" />
</head>

<body>

    <div class="admin-wrapper" id="adminWrapper">

        <!-- SIDEBAR -->
        <aside class="admin-sidebar">

            <div class="sidebar-header">
                <div class="sidebar-brand-icon">
                    <i class="bi bi-shop"></i>
                </div>

                <p class="sidebar-brand-text">RROMS Staff</p>
            </div>

            <nav class="sidebar-nav">

                <div class="sidebar-section-title">
                    Main Menu
                </div>

                <a asp-page="/Staff/Dashboard"
                   class="sidebar-link @(currentPage == "/Staff/Dashboard" ? "active" : "")">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>

                <a asp-page="/Staff/Reservations"
                   class="sidebar-link @(currentPage == "/Staff/Reservations" ? "active" : "")">
                    <i class="bi bi-calendar-check"></i>
                    <span>Reservations</span>
                </a>

                <a asp-page="/Staff/Order"
                   class="sidebar-link @(currentPage == "/Staff/Order" ? "active" : "")">
                    <i class="bi bi-receipt"></i>
                    <span>Orders</span>
                </a>

                <a asp-page="/Staff/Payment"
                   class="sidebar-link @(currentPage == "/Staff/Payment" ? "active" : "")">
                    <i class="bi bi-credit-card"></i>
                    <span>Payments</span>
                </a>

            </nav>
        </aside>

        <!-- MAIN CONTENT -->
        <div class="admin-main">

            <!-- TOPBAR -->
            <header class="admin-topbar">

                <div class="topbar-left">
                    <button type="button"
                            class="sidebar-toggle"
                            id="sidebarToggle"
                            aria-label="Toggle sidebar">
                        <i class="bi bi-list"></i>
                    </button>

                    <h5 class="topbar-title">@pageTitle</h5>
                </div>

                <div class="d-flex align-items-center gap-3">

                <div class="admin-profile">
                    <div class="profile-icon">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <div class="profile-text">
                        <span class="profile-name">
                            @(User.Identity?.Name ?? "Restaurant Staff")
                        </span>
                        <span class="profile-role">Staff Portal</span>
                    </div>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form method="post" asp-page="/Account/Logout" class="mb-0">
                        <button type="submit"
                                class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i>
                            Logout
                        </button>
                    </form>
                }

            </div>

            </header>

            <!-- PAGE CONTENT -->
            <main class="admin-content">
                @RenderBody()
            </main>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const wrapper = document.getElementById("adminWrapper");
        const toggleButton = document.getElementById("sidebarToggle");

        toggleButton.addEventListener("click", function () {
            if (window.innerWidth <= 900) {
                wrapper.classList.toggle("sidebar-mobile-open");
            } else {
                wrapper.classList.toggle("sidebar-collapsed");
            }
        });

        window.addEventListener("resize", function () {
            if (window.innerWidth > 900) {
                wrapper.classList.remove("sidebar-mobile-open");
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
