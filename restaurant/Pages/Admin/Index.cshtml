@page
@model dynamic
@{
	ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
	<h1>Administrator Interface (Placeholder)</h1>
	<p class="lead">This area will contain admin features: manage users, tables, menu items, reports and system settings.</p>

	<div class="row">
		<div class="col-md-4">
			<div class="card mb-3">
				<div class="card-body">
					<h5 class="card-title">User Management</h5>
					<p class="card-text">Create and assign roles to users.</p>
					<a class="btn btn-warning disabled">Open</a>
				</div>
			</div>
		</div>
		<div class="col-md-4">
			<div class="card mb-3">
				<div class="card-body">
					<h5 class="card-title">Menu & Tables</h5>
					<p class="card-text">Manage menu items, categories, and table layout.</p>
					<a class="btn btn-warning disabled">Open</a>
				</div>
			</div>
		</div>
		<div class="col-md-4">
			<div class="card mb-3">
				<div class="card-body">
					<h5 class="card-title">Reports</h5>
					<p class="card-text">Generate reservation and sales reports.</p>
					<a class="btn btn-warning disabled">Open</a>
				</div>
			</div>
		</div>
	</div>
</div>
