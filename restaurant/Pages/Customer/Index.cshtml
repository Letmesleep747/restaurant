@page
@model dynamic
@{
	ViewData["Title"] = "Customer Dashboard";
}

<div class="container mt-4">
	<h1>Customer Interface (Placeholder)</h1>
	<p class="lead">This area will contain customer features: register/profile, browse menu, make reservations, place orders, view history.</p>

	<div class="row">
		<div class="col-md-4">
			<div class="card mb-3">
				<div class="card-body">
					<h5 class="card-title">Profile</h5>
					<p class="card-text">Manage your profile and preferences.</p>
					<a class="btn btn-primary disabled">Open</a>
				</div>
			</div>
		</div>
		<div class="col-md-4">
			<div class="card mb-3">
				<div class="card-body">
					<h5 class="card-title">Reservations</h5>
					<p class="card-text">Make, modify or cancel table reservations.</p>
					<a class="btn btn-primary disabled">Open</a>
				</div>
			</div>
		</div>
		<div class="col-md-4">
			<div class="card mb-3">
				<div class="card-body">
					<h5 class="card-title">Menu & Orders</h5>
					<p class="card-text">Browse menu and place orders.</p>
					<a class="btn btn-primary disabled">Open</a>
				</div>
			</div>
		</div>
	</div>
</div>
