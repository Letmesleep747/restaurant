
@page
@model dynamic
@{
    ViewData["Title"] = "Welcome";
}

<section class="restaurant-hero">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <span class="eyebrow">WELCOME TO DINE &amp; DASH</span>

                <h1 class="mt-3 mb-4">
                    Great food.<br />
                    Beautiful moments.
                </h1>

                <p class="mb-4">
                    Start with our menu, order online, then book a table
                    if you are dining in.
                </p>

                <div class="d-flex flex-wrap gap-3">
                    <a class="btn btn-light btn-lg"
                       asp-page="/Customer/Menu">
                        Explore our menu &rarr;
                    </a>

                    <a class="btn btn-outline-light btn-lg"
                       asp-page="/Account/Login">
                        Sign in to order
                    </a>
                </div>

                <div class="d-flex flex-wrap gap-4 mt-4 text-white">
                    <span>★  Freshly prepared</span>
                    <span>✓  Friendly service</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-spacing pb-4">
    <div class="page-heading text-center">
        <span class="eyebrow">WHY DINE WITH US</span>
        <h2 class="mt-2">More than just a meal</h2>
        <p class="mx-auto" style="max-width: 600px;">
            Great flavours, convenient ordering, and a welcoming
            dining experience from start to finish.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card card-hover h-100">
                <div class="card-body text-center">
                    <div class="feature-icon">🍽️</div>
                    <h4>Delicious Menu</h4>
                    <p class="mb-0">
                        Discover a variety of dishes, clear prices,
                        and meals for different tastes.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card card-hover h-100">
                <div class="card-body text-center">
                    <div class="feature-icon">📅</div>
                    <h4>Easy Reservations</h4>
                    <p class="mb-0">
                        Request a table and manage your reservations
                        through your customer account.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card card-hover h-100">
                <div class="card-body text-center">
                    <div class="feature-icon">🛍️</div>
                    <h4>Simple Online Orders</h4>
                    <p class="mb-0">
                        Browse the menu, place orders, and review
                        your order status in one convenient place.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-spacing">
    <div class="d-flex flex-column flex-sm-row
                justify-content-between align-items-sm-end gap-3 mb-4">
        <div>
            <span class="eyebrow">OUR SELECTION</span>
            <h2 class="mt-2 mb-1">Popular dishes</h2>
            <p class="mb-0">
                A few favourites to get you started.
            </p>
        </div>

        <a class="btn btn-outline-primary"
           asp-page="/Customer/Menu">
            View full menu &rarr;
        </a>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <article class="card card-hover h-100">
                <img class="food-image"
                     src="https://images.unsplash.com/photo-1579751626657-72bc17010498?auto=format&amp;fit=crop&amp;w=900&amp;q=80"
                     alt="Freshly prepared pizza"
                     loading="lazy" />

                <div class="card-body d-flex flex-column">
                    <span class="eyebrow">HOUSE FAVOURITE</span>
                    <h4 class="mt-2">Classic Pizza</h4>
                    <p>
                        A comforting classic with rich tomato sauce,
                        melted cheese, and delicious toppings.
                    </p>
                    <div class="mt-auto d-flex justify-content-between
                                align-items-center">
                        <span class="food-price">Explore menu</span>
                        <a class="btn btn-primary btn-sm"
                           asp-page="/Customer/Menu">
                            View dish
                        </a>
                    </div>
                </div>
            </article>
        </div>

        <div class="col-md-6 col-lg-4">
            <article class="card card-hover h-100">
                <img class="food-image"
                     src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&amp;fit=crop&amp;w=900&amp;q=80"
                     alt="Gourmet burger with fresh ingredients"
                     loading="lazy" />

                <div class="card-body d-flex flex-column">
                    <span class="eyebrow">CUSTOMER FAVOURITE</span>
                    <h4 class="mt-2">Signature Burger</h4>
                    <p>
                        A juicy burger served with fresh ingredients
                        and a satisfying combination of flavours.
                    </p>
                    <div class="mt-auto d-flex justify-content-between
                                align-items-center">
                        <span class="food-price">Explore menu</span>
                        <a class="btn btn-primary btn-sm"
                           asp-page="/Customer/Menu">
                            View dish
                        </a>
                    </div>
                </div>
            </article>
        </div>

        <div class="col-md-6 col-lg-4">
            <article class="card card-hover h-100">
                <img class="food-image"
                     src="https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&amp;fit=crop&amp;w=900&amp;q=80"
                     alt="Fresh colourful salad"
                     loading="lazy" />

                <div class="card-body d-flex flex-column">
                    <span class="eyebrow">FRESH &amp; DELICIOUS</span>
                    <h4 class="mt-2">Garden Salad</h4>
                    <p>
                        A colourful mix of fresh vegetables for
                        a lighter and refreshing meal.
                    </p>
                    <div class="mt-auto d-flex justify-content-between
                                align-items-center">
                        <span class="food-price">Explore menu</span>
                        <a class="btn btn-primary btn-sm"
                           asp-page="/Customer/Menu">
                            View dish
                        </a>
                    </div>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="mb-4">
    <div class="card">
        <div class="card-body p-4 p-lg-5 text-center">
            <span class="eyebrow">YOUR NEXT GREAT MEAL</span>
            <h2 class="mt-2">Hungry? Start with the menu.</h2>
            <p class="mx-auto" style="max-width: 580px;">
                Browse dishes and place an order online. Already have a
                booking? You can link dine-in orders to your reservation at checkout.
            </p>

            <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
                <a class="btn btn-primary btn-lg"
                   asp-page="/Customer/Menu">
                    Browse menu
                </a>

                <a class="btn btn-outline-primary btn-lg"
                   asp-page="/Customer/Reservations/Create">
                    Book a table
                </a>
            </div>
        </div>
    </div>
</section>
