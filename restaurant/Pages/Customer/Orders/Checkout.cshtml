@page
@model restaurant.Pages.Customer.Orders.CheckoutModel
@{
    ViewData["Title"] = "Checkout";
}

<h1>Checkout</h1>

<div asp-validation-summary="All" class="text-danger"></div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <table class="table align-middle">
            <thead>
                <tr><th>Item</th><th>Price</th><th>Qty</th><th>Subtotal</th><th></th></tr>
            </thead>
            <tbody id="cart-table-body"></tbody>
        </table>
        <div class="text-end fw-bold fs-5">Total: $<span id="cart-total">0.00</span></div>
    </div>
</div>

<form method="post" id="place-order-form" class="card shadow-sm">
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label">Dining option</label>
            <select asp-for="ReservationId" class="form-select">
                <option value="">Takeaway / no table booking</option>
                @foreach (var r in Model.UpcomingReservations)
                {
                    <option value="@r.Id">
                        Dine-in: @r.ReservationDate.ToString("dd MMM") at @r.StartTime.ToString(@"hh\:mm") &middot; @r.PartySize guests
                    </option>
                }
            </select>
            <div class="form-text">
                Ordering comes first. Link a reservation only if you already booked a table.
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Notes" class="form-label">Special instructions (optional)</label>
            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
        </div>

        <div id="cart-hidden-inputs"></div>

        <button type="submit" class="btn btn-success">Place Order</button>
        <a class="btn btn-outline-secondary" asp-page="/Customer/Menu">Back to Menu</a>
    </div>
</form>

@section Scripts {
    <script src="~/js/customer-cart.js"></script>
}
