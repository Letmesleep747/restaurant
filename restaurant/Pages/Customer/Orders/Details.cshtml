@page "{id:int}"
@model restaurant.Pages.Customer.Orders.DetailsModel
@{
    ViewData["Title"] = "Order Details";
}

@if (Model.Order == null)
{
    <p>Order not found.</p>
}
else
{
    var o = Model.Order;
    <h1>Order #@o.Id</h1>
    <p class="text-muted">Placed @o.OrderDate.ToString("dd MMM yyyy HH:mm")</p>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow-sm mb-3">
                <div class="card-header">Items</div>
                <ul class="list-group list-group-flush">
                    @foreach (var item in o.OrderItems)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@item.MenuItem?.Name &times; @item.Quantity</span>
                            <span>@item.Subtotal.ToString("C")</span>
                        </li>
                    }
                </ul>
                <div class="card-footer text-end fw-bold">Total: @o.TotalAmount.ToString("C")</div>
            </div>

            @if (!string.IsNullOrEmpty(o.Notes))
            {
                <p><strong>Notes:</strong> @o.Notes</p>
            }
            @if (o.Reservation != null)
            {
                <p><strong>Linked reservation:</strong> @o.Reservation.ReservationDate.ToString("dd MMM yyyy") at @o.Reservation.StartTime.ToString(@"hh\:mm")</p>
            }
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Order Status</h6>
                    <p class="fs-4"><span class="badge text-bg-info" id="order-status-badge">@o.Status</span></p>

                    <h6 class="text-muted">Payment Status</h6>
                    <p class="fs-5">
                        <span class="badge text-bg-@(o.Payment?.Status == restaurant.Models.Enums.PaymentStatus.Paid ? "success" : "secondary")" id="payment-status-badge">
                            @(o.Payment?.Status.ToString() ?? "Unpaid")
                        </span>
                    </p>

                    @if (o.Payment?.Status != restaurant.Models.Enums.PaymentStatus.Paid && o.Status != restaurant.Models.Enums.OrderStatus.Cancelled)
                    {
                        <form method="post" asp-page-handler="Pay" asp-route-id="@o.Id" class="d-inline">
                            <button type="submit" class="btn btn-success">Pay Now</button>
                        </form>
                    }

                    @if (o.Status == restaurant.Models.Enums.OrderStatus.Placed)
                    {
                        <form method="post" asp-page-handler="Cancel" asp-route-id="@o.Id" class="d-inline"
                              onsubmit="return confirm('Cancel this order?');">
                            <button type="submit" class="btn btn-outline-danger">Cancel Order</button>
                        </form>
                    }

                    @if (o.Status == restaurant.Models.Enums.OrderStatus.Completed)
                    {
                        <a class="btn btn-outline-primary mt-2" asp-page="/Customer/Feedback/Create" asp-route-orderId="@o.Id">Leave Feedback</a>
                    }
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="~/js/customer-cart.js"></script>
        <script>
            // Wipe localStorage cart after a successful Place Order redirect.
            @if (TempData["ClearCart"] != null)
            {
                <text>
                localStorage.removeItem("rroms_cart");
                sessionStorage.removeItem("rroms_cart_backup");
                if (window.rromsCart) window.rromsCart.clearCart();
                </text>
            }

            const orderId = @o.Id;
            async function refreshOrderStatus() {
                try {
                    const res = await fetch(`/Customer/Orders/Details/${orderId}?handler=Status`, {
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });
                    if (!res.ok) return;
                    const data = await res.json();
                    document.getElementById("order-status-badge").textContent = data.status;
                    const payBadge = document.getElementById("payment-status-badge");
                    if (payBadge) {
                        payBadge.textContent = data.paymentStatus;
                        payBadge.className = "badge text-bg-" + (data.paymentStatus === "Paid" ? "success" : "secondary");
                    }
                } catch {
                    // Ignore — will retry on the next tick.
                }
            }
            setInterval(refreshOrderStatus, 8000);
        </script>
    }
}
