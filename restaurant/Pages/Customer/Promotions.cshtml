@page
@model restaurant.Pages.Customer.PromotionsModel
@{
    ViewData["Title"] = "Promotions";
}

<div class="page-heading">
    <span class="eyebrow">SPECIAL OFFERS</span>
    <h1 class="mt-2">Promotions</h1>
    <p class="mb-0">Current deals and discounts at Dine &amp; Dash.</p>
</div>

@await Component.InvokeAsync("ActiveAnnouncements")

@if (!Model.Promotions.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <div class="fs-1">🏷️</div>
            <h5 class="mt-3">No promotions right now</h5>
            <p class="mb-0">Check back soon for new offers.</p>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var promo in Model.Promotions)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card card-hover h-100">
                    <div class="card-body d-flex flex-column">
                        <span class="badge text-bg-warning align-self-start mb-2">
                            @if (promo.DiscountType == "Percentage")
                            {
                                @($"{promo.DiscountValue:0.##}% OFF")
                            }
                            else
                            {
                                @($"RM {promo.DiscountValue:0.00} OFF")
                            }
                        </span>

                        <h4 class="mb-2">@promo.Name</h4>

                        @if (!string.IsNullOrWhiteSpace(promo.Description))
                        {
                            <p>@promo.Description</p>
                        }

                        <small class="text-muted mt-auto">
                            Valid until @promo.EndDate.ToString("dd MMM yyyy")
                        </small>
                    </div>
                </div>
            </div>
        }
    </div>
}
