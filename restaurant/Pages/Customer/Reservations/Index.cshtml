@page
@model restaurant.Pages.Customer.Reservations.IndexModel
@{
    ViewData["Title"] = "My Reservations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>My Reservations</h1>
    <a class="btn btn-primary" asp-page="/Customer/Reservations/Create">New Reservation</a>
</div>

@if (!Model.Reservations.Any())
{
    <p class="text-muted">You have no reservations yet.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr><th>Date</th><th>Time</th><th>Table</th><th>Party Size</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Reservations)
            {
                <tr>
                    <td>@r.ReservationDate.ToString("dd MMM yyyy")</td>
                    <td>@r.StartTime.ToString(@"hh\:mm")</td>
                    <td>@(r.Table?.TableNumber ?? "-")</td>
                    <td>@r.PartySize</td>
                    <td><span class="badge text-bg-secondary">@r.Status</span></td>
                    <td class="d-flex gap-2">
                        @if (r.Status == restaurant.Models.Enums.ReservationStatus.Pending || r.Status == restaurant.Models.Enums.ReservationStatus.Confirmed)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-page="/Customer/Reservations/Edit" asp-route-id="@r.Id">Modify</a>
                            <form method="post" asp-page-handler="Cancel" asp-route-id="@r.Id" onsubmit="return confirm('Cancel this reservation?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
