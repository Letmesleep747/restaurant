@page
@model restaurant.Pages.Customer.MenuModel
@{
    ViewData["Title"] = "Menu";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Our Menu</h1>
    <a class="btn btn-outline-primary" asp-page="/Customer/Orders/Checkout">
        View Cart <span class="badge text-bg-primary" id="cart-count">0</span>
    </a>
</div>

<div class="mb-3">
    <a class="btn btn-sm @(Model.CategoryFilter == null ? "btn-primary" : "btn-outline-primary")"
       asp-page="/Customer/Menu">All</a>
    @foreach (var cat in Model.Categories)
    {
        <a class="btn btn-sm @(Model.CategoryFilter == cat ? "btn-primary" : "btn-outline-primary")"
           asp-page="/Customer/Menu" asp-route-CategoryFilter="@cat">@cat</a>
    }
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model.Items)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height:160px;object-fit:cover;">
                }
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text text-muted small">@item.Description</p>
                    <p class="fw-bold">@item.Price.ToString("C")</p>
                    <div class="mt-auto d-flex gap-2">
                        <input type="number" min="1" value="1" class="form-control form-control-sm qty-input" style="width:70px" data-id="@item.Id" />
                        <button type="button" class="btn btn-sm btn-success add-to-cart-btn"
                                data-id="@item.Id" data-name="@item.Name" data-price="@item.Price">
                            Add to Cart
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Items.Any())
{
    <p class="text-muted mt-4">No menu items are available right now.</p>
}

@section Scripts {
    <script src="~/js/customer-cart.js"></script>
}
