
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f766e" />
    <title>@ViewData["Title"] - Dine &amp; Dash</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand" asp-page="/Customer/Index"
                   aria-label="Dine and Dash home">
                    <span class="brand-mark" aria-hidden="true">D</span>
                    <span>Dine &amp; Dash</span>
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav me-auto ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Customer/Menu">
                                Menu
                            </a>
                        </li>

                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-page="/Customer/Reservations/Index">
                                    Reservations
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-page="/Customer/Orders/Index">
                                    Orders
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-page="/Customer/Notifications/Index">
                                    Notifications
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center">
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Profile">
                                    My Profile
                                </a>
                            </li>

                            @if (User.IsInRole("Staff"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Staff/Index">
                                        Staff
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Admin/Index">
                                        Admin
                                    </a>
                                </li>
                            }

                            <li class="nav-item">
                                <form asp-page="/Account/Logout" method="post"
                                      class="d-inline">
                                    <button type="submit"
                                            class="btn btn-primary btn-sm ms-lg-2">
                                        Sign out
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Account/Login">
                                    Sign in
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm ms-lg-2"
                                   asp-page="/Account/Register">
                                    Create account
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container py-4">
        @RenderBody()
    </main>

    <div id="toast-container"
         class="toast-container position-fixed bottom-0 end-0 p-3">
    </div>

    <footer class="site-footer mt-auto">
        <div class="container d-flex flex-column flex-sm-row
            justify-content-between align-items-sm-center gap-2">
            <p>
                &copy; @DateTime.Now.Year Dine &amp; Dash.
                Crafted for good food and great moments.
            </p>
            <a asp-page="/Privacy">Privacy policy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
