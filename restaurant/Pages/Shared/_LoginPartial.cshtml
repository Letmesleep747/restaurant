@using Microsoft.AspNetCore.Identity
@using restaurant.Models
@inject SignInManager<ApplicationUser> SignInManager

@if (SignInManager?.IsSignedIn(User) ?? false)
{
	<ul class="navbar-nav">
		<li class="nav-item">
			<a class="nav-link text-dark" asp-page="/Profile">Hello @User.Identity?.Name</a>
		</li>
		<li class="nav-item">
			<form class="form-inline" asp-page="/Account/Logout" method="post">
				<button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
			</form>
		</li>
	</ul>
}
else
{
	<ul class="navbar-nav">
		<li class="nav-item">
			<a class="nav-link text-dark" asp-page="/Account/Login">Login</a>
		</li>
		<li class="nav-item">
			<a class="nav-link text-dark" asp-page="/Account/Register">Register</a>
		</li>
	</ul>
}
