@page
@model dynamic
@{
	ViewData["Title"] = "Staff Dashboard";
}

<div class="container mt-4">
	<h1>Staff Interface (Placeholder)</h1>
	<p class="lead">This area will contain restaurant staff features: view reservations, manage orders, update statuses.</p>

	<div class="row">
		<div class="col-md-6">
			<div class="card mb-3">
				<div class="card-body">
					<h5 class="card-title">Reservations</h5>
					<p class="card-text">View and manage daily reservations.</p>
					<a class="btn btn-secondary disabled">Open</a>
				</div>
			</div>
		</div>
		<div class="col-md-6">
			<div class="card mb-3">
				<div class="card-body">
					<h5 class="card-title">Orders</h5>
					<p class="card-text">Receive and update customer orders.</p>
					<a class="btn btn-secondary disabled">Open</a>
				</div>
			</div>
		</div>
	</div>
</div>
